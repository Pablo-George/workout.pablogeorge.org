DATABASE_URL=file:./data/workoutapp.db
PORT=8080
SESSION_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
GEMINI_API_KEY=

# Sign in with Apple (required by App Store guideline 4.8 since Google
# sign-in is offered). Leave unset to keep it hidden/disabled.
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_SIGNIN_CALLBACK_URL=http://localhost:8080/auth/apple/callback

# Optional music integrations
MUSIC_ENABLED=false
MUSIC_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-long-random-value
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://127.0.0.1:8080/music/spotify/callback
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
