generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserProfile {
  userId      String  @id
  displayName String
  pictureUrl  String?
  inviteToken String? @unique
  hideWeight  Boolean @default(true)
}

model CoreWorkout {
  id     Int             @id @default(autoincrement())
  name   String
  userId String

  configs      UserLiftConfig[]
  logs         WorkoutLog[]
  tmLogs       TrainingMaxLog[]
  auxLifts     AuxLift[]
  groupMembers GroupSessionMember[]

  @@unique([userId, name])
}

model UserLiftConfig {
  id          Int         @id @default(autoincrement())
  userId      String
  liftId      Int
  trainingMax Float
  currentWeek Int         @default(1)
  lift        CoreWorkout @relation(fields: [liftId], references: [id])

  @@unique([userId, liftId])
}

model WorkoutLog {
  id          Int         @id @default(autoincrement())
  userId      String
  liftId      Int
  week        Int
  amrapReps   Int
  completedOn String
  lift        CoreWorkout @relation(fields: [liftId], references: [id])
}

model TrainingMaxLog {
  id          Int         @id @default(autoincrement())
  userId      String
  liftId      Int
  trainingMax Float
  loggedOn    String
  lift        CoreWorkout @relation(fields: [liftId], references: [id])
}

model BodyWeightLog {
  id        Int     @id @default(autoincrement())
  userId    String
  weightLbs Float
  loggedOn  String

  @@unique([userId, loggedOn])
}

model Post {
  id        Int      @id @default(autoincrement())
  authorId  String
  content   String?
  imageUrl  String?
  createdAt DateTime @default(now())
  parentId  Int?
  parent    Post?    @relation("PostReplies", fields: [parentId], references: [id])
  replies   Post[]   @relation("PostReplies")
}

model AuxLift {
  id                   Int          @id @default(autoincrement())
  userId               String
  liftId               Int
  name                 String
  description          String
  setsReps             String
  weightRecommendation String       @default("")
  youtubeSearchUrl     String
  displayOrder         Int          @default(0)
  lift                 CoreWorkout  @relation(fields: [liftId], references: [id])
  logs                 AuxLiftLog[]
}

model AuxLiftLog {
  id          Int     @id @default(autoincrement())
  userId      String
  auxLiftId   Int
  weightLbs   Float?
  completedOn String
  auxLift     AuxLift @relation(fields: [auxLiftId], references: [id])
}

model CalorieEntry {
  id          Int      @id @default(autoincrement())
  userId      String
  description String
  calories    Int
  proteinG    Int?
  carbsG      Int?
  breakdown   String?
  imageUrl    String?
  loggedOn    String
  createdAt   DateTime @default(now())
}

model ExerciseGuide {
  id       Int     @id @default(autoincrement())
  liftName String  @unique
  // Null until generation finishes. Generation is asynchronous because the
  // image model routinely takes 15-60s, which no HTTP gateway will wait for.
  imageUrl String?
  status   String  @default("PENDING") // PENDING | READY | FAILED
  error    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Friendship {
  id            Int              @id @default(autoincrement())
  requesterId   String
  addresseeId   String
  status        String           @default("PENDING")
  createdAt     DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

model GroupSession {
  id             Int                  @id @default(autoincrement())
  code           String               @unique
  hostId         String
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now())
  members        GroupSessionMember[]
  setCompletions GroupSetCompletion[]
}

/// Which sets each member has crossed off during a live session.
///
/// Previously a module-level Map, which meant progress was lost on restart and
/// could not survive more than one server process.
model GroupSetCompletion {
  id        Int          @id @default(autoincrement())
  sessionId Int
  userId    String
  /// Positional key ("s0", "s1", ...) into the member's generated plan.
  setKey    String
  createdAt DateTime     @default(now())
  session   GroupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, setKey])
  @@index([sessionId])
}

model GroupSessionMember {
  id        Int          @id @default(autoincrement())
  sessionId Int
  userId    String
  liftId    Int
  status    String       @default("ACTIVE")
  joinedAt  DateTime     @default(now())
  session   GroupSession @relation(fields: [sessionId], references: [id])
  lift      CoreWorkout  @relation(fields: [liftId], references: [id])

  @@unique([sessionId, userId])
}


