<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= groupsEnabled ? "Group Workout" : "Workout" %></title>
    <%- include('partials/pwa-head') %>
    <% if (isMember && music?.configured?.appleMusic) { %>
    <script src="https://js-cdn.music.apple.com/musickit/v3/musickit.js"></script>
    <% } %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0f0f0f;
            color: #fff;
            min-height: 100dvh;
            padding-bottom: calc(76px + env(safe-area-inset-bottom));
        }

        /* ── Bottom nav ── */
        nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 100;
            display: flex;
            background: #111;
            border-top: 1px solid #222;
            padding-bottom: env(safe-area-inset-bottom);
        }
        nav button,
        nav a {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 0.75rem 0.5rem;
            background: none;
            border: none;
            color: #555;
            font-size: 0.7rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: color 0.15s;
        }
        nav button.active,
        nav a.active { color: #4169E1; }
        nav button svg,
        nav a svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ── Header ── */
        .header {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #0f0f0f;
            border-bottom: 1px solid #1e1e1e;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .back-link { color: #4169E1; font-size: 0.9rem; font-weight: 600; text-decoration: none; flex-shrink: 0; }
        .header-title { font-size: 0.9rem; font-weight: 700; flex: 1; }
        .code-chip {
            background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 20px;
            padding: 0.3rem 0.75rem; font-size: 0.82rem; font-weight: 700;
            color: #4169E1; letter-spacing: 0.12em; cursor: pointer; flex-shrink: 0; user-select: none;
        }
        .copy-feedback { font-size: 0.7rem; color: #4ade80; opacity: 0; margin-left: 0.25rem; transition: opacity 0.3s; }

        /* ── Member tabs ── */
        .tabs {
            position: sticky; top: 49px; z-index: 9; background: #0f0f0f;
            border-bottom: 1px solid #1e1e1e;
            display: flex; overflow-x: auto; scrollbar-width: none;
        }
        .tabs::-webkit-scrollbar { display: none; }
        .tab-btn {
            flex-shrink: 0; padding: 0.7rem 1.25rem; background: none;
            border: none; border-bottom: 2px solid transparent;
            color: #555; font-size: 0.88rem; font-weight: 600; cursor: pointer;
            display: flex; align-items: center; gap: 0.4rem;
            transition: color 0.15s, border-color 0.15s;
        }
        .tab-btn.active { color: #fff; border-bottom-color: #4169E1; }
        .tab-btn.mine.active { border-bottom-color: #4ade80; }
        .done-dot { display: none; width: 7px; height: 7px; background: #4ade80; border-radius: 50%; }

        /* ── Panels ── */
        .panel { display: none; padding: 1.5rem 1rem 2rem; }
        .panel.active { display: flex; flex-direction: column; gap: 1.5rem; }

        /* ── Shared set-card styles (same as solo workout.ejs) ── */
        .lift-title { font-size: 2rem; font-weight: 800; letter-spacing: -0.5px; }
        .meta-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.4rem; }
        .week-badge {
            background: #1a2a3a; color: #4169E1; border-radius: 20px;
            padding: 0.3rem 0.8rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.03em;
        }
        .tm-badge { color: #555; font-size: 0.82rem; }
        .section-label {
            font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; color: #444; text-transform: uppercase;
        }
        .sets-group { display: flex; flex-direction: column; gap: 0.6rem; }
        .set-card {
            background: #1a1a1a; border-radius: 14px; padding: 1.1rem 1.2rem;
            display: grid; grid-template-columns: 44px 1fr; gap: 0 0.9rem; align-items: start;
        }
        .set-card.amrap { background: #0e1e33; border: 1.5px solid #4169E155; }
        .set-card.interactive { cursor: pointer; user-select: none; }
        .set-card.interactive:active { opacity: 0.6; }
        .set-card.done { opacity: 0.35; text-decoration: line-through; }
        .set-pct { font-size: 0.78rem; font-weight: 700; color: #555; padding-top: 0.35rem; text-align: center; }
        .set-card.amrap .set-pct { color: #4169E1; }
        .set-body { display: flex; flex-direction: column; gap: 0.2rem; }
        .set-weight-reps { font-size: 1.45rem; font-weight: 800; letter-spacing: -0.5px; line-height: 1.1; }
        .set-weight-reps .reps { font-size: 1rem; font-weight: 500; color: #888; }
        .set-card.amrap .set-weight-reps .reps { color: #4169E1; font-weight: 700; }
        .set-plates { font-size: 0.88rem; color: #666; margin-top: 0.15rem; }
        .set-plates strong { color: #999; font-weight: 600; }

        /* ── Complete section ── */
        .complete-section {
            background: #1a1a1a; border-radius: 14px; padding: 1.2rem;
            display: flex; flex-direction: column; gap: 0.75rem;
        }
        .amrap-input-row { display: flex; align-items: center; gap: 0.6rem; }
        .amrap-input-row input {
            flex: 1; background: #0f0f0f; border: 1.5px solid #2a3a4a; border-radius: 10px;
            color: #fff; font-size: 1.1rem; font-weight: 700; padding: 0.65rem 0.9rem; outline: none;
            -moz-appearance: textfield;
        }
        .amrap-input-row input::-webkit-outer-spin-button,
        .amrap-input-row input::-webkit-inner-spin-button { -webkit-appearance: none; }
        .amrap-input-row input:focus { border-color: #4169E1; }
        .amrap-input-row label { font-size: 0.82rem; color: #555; white-space: nowrap; }
        .btn-complete {
            width: 100%; padding: 1.05rem; background: #4169E1; border: none; border-radius: 14px;
            color: #fff; font-size: 1.05rem; font-weight: 700; cursor: pointer;
        }
        .btn-complete:active { opacity: 0.8; }
        .btn-complete:disabled { background: #2a2a2a; color: #666; cursor: not-allowed; }
        .my-done-badge { text-align: center; padding: 1.5rem; color: #4ade80; font-size: 1rem; font-weight: 700; }
        .other-done-badge { text-align: center; padding: 0.75rem; color: #4ade80; font-size: 0.85rem; font-weight: 600; }

        /* ── Session done bar ── */
        .session-done-bar {
            position: fixed; left: 0; right: 0; bottom: calc(64px + env(safe-area-inset-bottom));
            background: #1a2a1a; border-top: 1px solid #2a3a2a;
            padding: 0.9rem 1rem; text-align: center;
            font-size: 0.88rem; font-weight: 700; color: #4ade80; z-index: 50;
        }

        /* ── Join UI ── */
        .join-wrap { max-width: 400px; margin: 3rem auto; padding: 1.5rem 1rem; }
        .join-title { font-size: 1.4rem; font-weight: 800; margin-bottom: 0.35rem; }
        .join-sub { font-size: 0.85rem; color: #555; margin-bottom: 1.5rem; }
        .join-select {
            width: 100%; background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 8px;
            color: #fff; font-size: 0.9rem; padding: 0.65rem 0.75rem; outline: none; margin-bottom: 0.75rem;
        }
        .btn-join {
            width: 100%; background: #4169E1; border: none; border-radius: 8px;
            color: #fff; font-size: 0.95rem; font-weight: 700; padding: 0.75rem; cursor: pointer;
        }
        .btn-back-home { display: block; text-align: center; margin-top: 1rem; color: #4169E1; font-size: 0.9rem; font-weight: 600; text-decoration: none; }

        /* ── Aux lifts loader ── */
        /* Aux lifts normally finish generating in the background while the
           user is doing their core sets, so /complete returns instantly and
           this never has time to appear. It's only a safety net for someone
           who logs their AMRAP unusually fast. */
        #aux-loader {
            display: none; position: fixed; inset: 0; background: #0f0f0f; z-index: 9998;
            flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
        }
        #aux-loader.show { display: flex; }
        #aux-loader .spinner {
            width: 36px; height: 36px; border: 3px solid #2a2a2a; border-top-color: #4169E1;
            border-radius: 50%; animation: spin 0.8s linear infinite;
        }
        #aux-loader .label { color: #555; font-size: 0.85rem; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Training max popup ──
           display stays flex always (it's fixed-position) so opacity/transform
           can transition on both open AND close — display:none can't animate. */
        .tm-popup-overlay {
            display: flex; position: fixed; inset: 0; z-index: 9999;
            background: rgba(0,0,0,0.7); align-items: center; justify-content: center; padding: 1.5rem;
            opacity: 0; visibility: hidden; pointer-events: none;
            transition: opacity 0.25s ease, visibility 0s linear 0.25s;
        }
        .tm-popup-overlay.show {
            opacity: 1; visibility: visible; pointer-events: auto;
            transition: opacity 0.25s ease, visibility 0s linear 0s;
        }
        .tm-popup-card {
            background: #171717; border-radius: 20px; padding: 2rem 1.5rem;
            max-width: 340px; width: 100%; text-align: center;
            border: 1.5px solid #2a2a2a;
            transform: translateY(24px) scale(0.9);
            transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .tm-popup-overlay.show .tm-popup-card { transform: translateY(0) scale(1); }
        .tm-popup-card.up { border-color: #4ade8055; }
        .tm-popup-card.down { border-color: #f8717155; }
        .tm-popup-emoji { font-size: 2.75rem; line-height: 1; margin-bottom: 0.75rem; }
        .tm-popup-title { font-size: 1.15rem; font-weight: 800; margin-bottom: 0.4rem; }
        .tm-popup-title.up { color: #4ade80; }
        .tm-popup-title.down { color: #f87171; }
        .tm-popup-body { font-size: 0.9rem; color: #aaa; line-height: 1.4; margin-bottom: 1.4rem; }
        .tm-popup-body strong { color: #fff; }
        .btn-tm-popup {
            width: 100%; padding: 0.9rem; background: #4169E1; border: none; border-radius: 12px;
            color: #fff; font-size: 0.95rem; font-weight: 700; cursor: pointer;
        }
        .btn-tm-popup:active { opacity: 0.8; }
        .music-card { display:flex;align-items:center;gap:0.8rem;background:#171717;border:1px solid #292929;border-radius:14px;padding:0.8rem; }
        .music-art { width:48px;height:48px;border-radius:8px;object-fit:cover;background:#292929;flex-shrink:0; }
        .music-note { width:48px;height:48px;border-radius:8px;background:linear-gradient(135deg,#fa2d48,#8b5cf6);display:flex;align-items:center;justify-content:center;font-size:1.35rem;flex-shrink:0; }
        .music-copy { min-width:0;flex:1; }
        .music-label { color:#777;font-size:0.68rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase; }
        .music-title { font-size:0.9rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px; }
        .music-artist { color:#777;font-size:0.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .music-action { color:#4169E1;border:1px solid #30445e;border-radius:9px;padding:0.45rem 0.6rem;font-size:0.75rem;font-weight:700; }
    </style>
    <%- include('partials/app-theme') %>
</head>
<body class="workout-page">

    <div class="header">
        <% if (isMember && myStatus === 'ACTIVE') { %>
        <form action="/group/<%= session.id %>/leave" method="post" style="display:contents;"
              onsubmit="return confirm('Leave this workout? Your progress here will be discarded.');">
            <button type="submit" class="back-link"
                    style="background:none;border:none;cursor:pointer;padding:0;font-family:inherit;">
                ← Back
            </button>
        </form>
        <% } else if (!(isMember && myStatus === 'LOGGED')) { %>
        <!-- No back link on the aux lifts screen (status LOGGED): the lift is
             already saved there and "#tab-workouts" bounces straight back to
             this same session, so the only way out is the Close button. -->
        <a href="/#tab-workouts" class="back-link">← Back</a>
        <% } %>
        <div class="header-title"><%= groupsEnabled ? "Group Workout" : "Workout" %></div>
    </div>

    <% if (!isMember) { %>

        <div class="join-wrap">
            <% if (sessionEnded) { %>
                <div class="join-title">Session Ended</div>
                <div class="join-sub">This group workout is already complete.</div>
                <a href="/" class="btn-back-home">← Back to home</a>
            <% } else { %>
                <div class="join-title">Join <%= hostName %>'s Workout</div>
                <div class="join-sub">You're joining an active group session.</div>
                <% if (myLifts.length === 0) { %>
                    <div style="color:#e05252;font-size:0.9rem;margin-bottom:1rem;">Set up a training max in Profile before joining.</div>
                    <a href="/#tab-profile" class="btn-back-home">Go to Profile →</a>
                <% } else { %>
                    <form action="/group/<%= session.id %>/join" method="post">
                        <div style="font-size:0.78rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.4rem;">Your lift</div>
                        <select name="liftId" class="join-select">
                            <% myLifts.forEach(l => { %>
                            <option value="<%= l.id %>"><%= l.name %></option>
                            <% }) %>
                        </select>
                        <button type="submit" class="btn-join">Join Session</button>
                    </form>
                <% } %>
            <% } %>
        </div>

    <% } else { %>

        <!-- Member tab bar -->
        <% if (groupsEnabled) { %>
        <div class="tabs" id="tab-bar">
            <% members.forEach((m, i) => { %>
            <button class="tab-btn <%= m.userId === myUserId ? 'mine' : '' %> <%= i === myTabIndex ? 'active' : '' %>"
                    id="tab-btn-<%= i %>"
                    onclick="showTab(<%= i %>)">
                <%= m.displayName %>
                <span class="done-dot" id="done-dot-<%= i %>"
                      style="display:<%= m.status === 'COMPLETED' ? 'inline-block' : 'none' %>"></span>
            </button>
            <% }) %>
        </div>
        <% } %>

        <!-- Member panels -->
        <% members.forEach((m, i) => { %>
        <div class="panel <%= i === myTabIndex ? 'active' : '' %>" id="panel-<%= i %>">

            <% if (m.plan) { %>

            <!-- Lift header (matches solo style) -->
            <div>
                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;">
                    <div class="lift-title"><%= m.liftName %></div>
                </div>
                <div class="meta-row">
                    <span class="week-badge">WEEK <%= m.plan.week %> &nbsp;·&nbsp; <%= m.plan.weekLabel %></span>
                    <span class="tm-badge">TM: <strong><%= m.plan.trainingMax %> lbs</strong></span>
                </div>
            </div>

            <% if (m.userId === myUserId && m.status === 'ACTIVE') { %>
            <% const selectedMusic = music.playlists.find(p => p.isSelected); %>
            <% if (selectedMusic) { %>
            <div class="music-card" id="workout-music-card">
                <% if (selectedMusic.artworkUrl) { %><img class="music-art" id="music-art" src="<%= selectedMusic.artworkUrl %>" alt=""/><% } else { %><div class="music-note" id="music-art">♫</div><% } %>
                <div class="music-copy">
                    <div class="music-label" id="music-label">Workout playlist</div>
                    <div class="music-title" id="music-title"><%= selectedMusic.name %></div>
                    <div class="music-artist" id="music-artist"><%= selectedMusic.provider === 'SPOTIFY' ? 'Spotify' : 'Apple Music' %></div>
                </div>
                <button type="button" class="music-action" id="music-action" onclick="startWorkoutMusic(true)">Play</button>
            </div>
            <% } %>
            <!-- Step 1: log the lift itself first. Aux lifts aren't shown yet
                 so there's nothing to get distracted by before this saves. -->
            <form action="/group/<%= session.id %>/complete" method="post"
                  onsubmit="this.loggedOn.value = new Date().toLocaleDateString('en-CA'); document.getElementById('aux-loader').classList.add('show');"
                  style="display:flex;flex-direction:column;gap:1.5rem;">
                <input type="hidden" name="loggedOn"/>
                <%- include('partials/workout-sets', {
                    plan: m.plan, interactive: true, showAmrapInput: true, dataUser: m.userId
                }) %>
                <button type="submit" class="btn-complete" id="move-to-aux-btn" disabled>Move to Auxiliaries</button>
            </form>
            <% } else if (m.userId === myUserId && m.status === 'LOGGED') { %>
            <!-- Step 2: lift is already saved — accessory work, then close out. -->
            <%- include('partials/workout-sets', {
                plan: m.plan, interactive: false, showAmrapInput: false, dataUser: m.userId
            }) %>
            <div class="my-done-badge">✓ Lift logged</div>
            <%- include('partials/workout-aux', { auxLifts: m.auxLifts }) %>
            <form action="/group/<%= session.id %>/close" method="post">
                <button type="submit" class="btn-complete">Close</button>
            </form>
            <% } else { %>
            <!-- Other members, or myself after closing -->
            <%- include('partials/workout-sets', {
                plan: m.plan,
                interactive: m.userId === myUserId,
                showAmrapInput: false,
                dataUser: m.userId
            }) %>
            <% if (m.userId === myUserId) { %>
                <div class="my-done-badge">✓ Workout Complete</div>
            <% } else { %>
                <div id="done-badge-<%= i %>" class="other-done-badge"
                     style="display:<%= m.status === 'COMPLETED' ? 'block' : 'none' %>">✓ Completed</div>
            <% } %>
            <%- include('partials/workout-aux', { auxLifts: m.auxLifts }) %>
            <% } %>

            <% } else { %>
            <div style="padding:2rem;text-align:center;color:#555;font-size:0.9rem;">Training max not configured.</div>
            <% } %>

        </div>
        <% }) %>

        <div class="session-done-bar" id="session-done-bar"
             style="display:<%= session.status === 'COMPLETED' ? 'block' : 'none' %>">
            Session Complete — Great workout!
        </div>

        <div id="aux-loader">
            <div class="spinner"></div>
            <div class="label">Creating your workout…</div>
        </div>

        <!-- Training max change popup -->
        <% if (tmPopup) { %>
        <div id="tm-popup-overlay" class="tm-popup-overlay">
            <div class="tm-popup-card <%= tmPopup.delta > 0 ? 'up' : 'down' %>">
                <div class="tm-popup-emoji"><%= tmPopup.delta > 0 ? '🎉' : '💪' %></div>
                <div class="tm-popup-title <%= tmPopup.delta > 0 ? 'up' : 'down' %>">
                    <%= tmPopup.delta > 0 ? 'New Training Max!' : 'Time to Reset' %>
                </div>
                <div class="tm-popup-body">
                    <% if (tmPopup.delta > 0) { %>
                        Great AMRAP set! Your <%= tmPopup.liftName %> training max just went up
                        <strong>+<%= tmPopup.delta %> lbs</strong>, to <strong><%= tmPopup.newMax %> lbs</strong>.
                    <% } else { %>
                        That rep didn't land, so your <%= tmPopup.liftName %> training max backed off
                        <strong><%= tmPopup.delta %> lbs</strong>, to <strong><%= tmPopup.newMax %> lbs</strong>.
                        Recover up and come back stronger next cycle!
                    <% } %>
                </div>
                <% if (prPopup) { %>
                <div style="background:#142218;border:1px solid #31543d;border-radius:10px;padding:0.7rem;margin:-0.5rem 0 0.9rem;color:#4ade80;font-size:0.82rem;font-weight:700;">
                    🏆 PR · <%= prPopup.weight %> lbs × <%= prPopup.reps %><% if (prPopup.trackTitle) { %><br><span style="color:#aaa;font-weight:500;">♫ <%= prPopup.trackTitle %> — <%= prPopup.trackArtist %></span><% } %>
                </div>
                <form action="/social/pr/<%= prPopup.logId %>" method="post" style="margin-bottom:0.55rem;">
                    <input type="hidden" name="returnTo" value="/group/<%= session.id %>"/>
                    <button type="submit" class="btn-tm-popup" style="background:#22c55e;color:#07140b;">Share PR</button>
                </form>
                <% } %>
                <button type="button" class="btn-tm-popup" onclick="closeTmPopup()">Let's go</button>
            </div>
        </div>
        <% } %>

        <% if (prPopup && !tmPopup) { %>
        <div id="pr-popup-overlay" class="tm-popup-overlay">
            <div class="tm-popup-card up">
                <div class="tm-popup-emoji">🏆</div>
                <div class="tm-popup-title up">New Personal Record!</div>
                <div class="tm-popup-body">
                    <strong><%= prPopup.weight %> lbs × <%= prPopup.reps %></strong> on <strong><%= prPopup.liftName %></strong>.
                    <% if (prPopup.trackTitle) { %><br><br>Soundtracked by <strong><%= prPopup.trackTitle %></strong> — <%= prPopup.trackArtist %>.<% } %>
                </div>
                <form action="/social/pr/<%= prPopup.logId %>" method="post" style="margin-bottom:0.55rem;">
                    <input type="hidden" name="returnTo" value="/group/<%= session.id %>"/>
                    <button type="submit" class="btn-tm-popup" style="background:#22c55e;color:#07140b;">Share PR</button>
                </form>
                <button type="button" class="btn-tm-popup" onclick="document.getElementById('pr-popup-overlay').classList.remove('show')">Not now</button>
            </div>
        </div>
        <% } %>

        <script>
            document.addEventListener('touchmove', function(e) { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });

            const sessionId = <%= session.id %>;
            const myUserId  = <%- JSON.stringify(myUserId) %>;
            const initialMemberCount = <%= members.length %>;
            const memberIndex = <%- JSON.stringify(members.map((m, i) => ({ i, userId: m.userId }))) %>;
            const selectedMusic = <%- JSON.stringify(music.playlists.find(p => p.isSelected) ?? null) %>;

            // ── Set completion state ──
            const serverCompleted = <%- JSON.stringify(completedSets) %>;
            const localCompleted = {};
            for (const [uid, keys] of Object.entries(serverCompleted)) {
                localCompleted[uid] = new Set(keys);
            }

            function applyAllStates() {
                document.querySelectorAll('.set-card[data-user]').forEach(el => {
                    const uid = el.dataset.user;
                    const key = el.dataset.key;
                    el.classList.toggle('done', !!(localCompleted[uid]?.has(key)));
                });
            }
            applyAllStates();

            function showTrack(track) {
                if (!track) return;
                document.getElementById('music-label').textContent = track.isPlaying ? 'Now playing' : 'Paused';
                document.getElementById('music-title').textContent = track.title;
                document.getElementById('music-artist').textContent = track.artist;
                const art = document.getElementById('music-art');
                if (track.artworkUrl && art?.tagName === 'IMG') art.src = track.artworkUrl.replace('{w}', '160').replace('{h}', '160');
            }

            async function syncAppleNowPlaying(music) {
                const item = music.player.nowPlayingItem;
                if (!item) return;
                const track = {
                    provider: 'APPLE_MUSIC', trackId: item.id, title: item.title || item.attributes?.name,
                    artist: item.artistName || item.attributes?.artistName || 'Unknown artist',
                    album: item.albumName || item.attributes?.albumName || null,
                    artworkUrl: item.artworkURL || item.attributes?.artwork?.url || null,
                    externalUrl: item.attributes?.url || null, isPlaying: music.player.isPlaying,
                    workoutSessionId: sessionId
                };
                showTrack(track);
                await fetch('/api/music/now-playing', { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(track) });
            }

            async function startWorkoutMusic(fromButton) {
                if (!selectedMusic) return;
                const action = document.getElementById('music-action');
                if (action) action.textContent = 'Starting…';
                try {
                    const response = await fetch('/api/music/start', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ workoutSessionId: sessionId }) });
                    const result = (await response.json()).data;
                    if (selectedMusic.provider === 'APPLE_MUSIC') {
                        const tokenResponse = await fetch('/api/music/apple/developer-token');
                        const { developerToken } = (await tokenResponse.json()).data;
                        await MusicKit.configure({ developerToken, app:{ name:'Workout', build:'1.1.0' } });
                        const apple = MusicKit.getInstance();
                        if (!apple.isAuthorized) await apple.authorize();
                        await apple.setQueue({ playlist: selectedMusic.providerPlaylistId });
                        await apple.play();
                        await syncAppleNowPlaying(apple);
                        setInterval(() => syncAppleNowPlaying(apple).catch(() => {}), 15000);
                    } else if (!result.started && result.reason === 'NO_ACTIVE_DEVICE') {
                        if (action) { action.textContent = 'Open Spotify'; action.onclick = () => window.open(selectedMusic.externalUrl, '_blank'); }
                        document.getElementById('music-label').textContent = 'Open Spotify on a device';
                        return;
                    }
                    if (action) action.style.display = 'none';
                } catch (error) {
                    if (action) action.textContent = 'Try again';
                    if (!fromButton) document.getElementById('music-label').textContent = 'Tap play to start';
                }
            }

            if (selectedMusic && !sessionStorage.getItem(`music-started-${sessionId}`)) {
                sessionStorage.setItem(`music-started-${sessionId}`, '1');
                startWorkoutMusic(false);
            }
            if (selectedMusic?.provider === 'SPOTIFY') {
                const refreshSpotifyTrack = async () => {
                    try {
                        const response = await fetch(`/api/music/now-playing?workoutSessionId=${sessionId}`);
                        showTrack((await response.json()).data);
                    } catch (_) {}
                };
                refreshSpotifyTrack();
                setInterval(refreshSpotifyTrack, 15000);
            }

            // Scroll my tab into view
            document.getElementById('tab-btn-<%= myTabIndex %>')
                ?.scrollIntoView({ block: 'nearest', inline: 'center' });

            // ── Tab switching ──
            function showTab(idx) {
                document.querySelectorAll('.tab-btn').forEach((t, i) => t.classList.toggle('active', i === idx));
                document.querySelectorAll('.panel').forEach((p, i) => p.classList.toggle('active', i === idx));
                document.getElementById(`tab-btn-${idx}`)
                    ?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }

            // ── Tap-to-cross-out (my sets only) ──
            function toggleSetDone(el) {
                const uid = el.dataset.user;
                const key = el.dataset.key;
                if (uid !== myUserId) return;
                if (!localCompleted[uid]) localCompleted[uid] = new Set();
                if (localCompleted[uid].has(key)) {
                    localCompleted[uid].delete(key); el.classList.remove('done');
                } else {
                    localCompleted[uid].add(key);    el.classList.add('done');
                }
                fetch(`/group/${sessionId}/set-toggle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ setKey: key })
                }).catch(() => {});
            }

            // ── Training max popup ──
            <% if (tmPopup || prPopup) { %>
            history.replaceState(null, '', location.pathname);
            // Rendered without .show so the slide-in transition has a closed
            // state to animate from; double rAF makes sure that first (closed)
            // frame actually paints before .show gets added.
            requestAnimationFrame(() => requestAnimationFrame(() => {
                const overlay = document.getElementById('tm-popup-overlay') || document.getElementById('pr-popup-overlay');
                overlay?.classList.add('show');
                <% if ((tmPopup && tmPopup.delta > 0) || prPopup) { %>
                setTimeout(() => fireConfetti(window.innerWidth / 2, window.innerHeight * 0.35, 48), 150);
                <% } %>
            }));
            <% } %>
            function closeTmPopup() {
                document.getElementById('tm-popup-overlay')?.classList.remove('show');
            }

            // ── Copy session code ──
            function copyCode() {
                navigator.clipboard.writeText('<%= session.code %>').catch(() => {});
                const fb = document.getElementById('copy-feedback');
                fb.style.opacity = '1';
                setTimeout(() => fb.style.opacity = '0', 1500);
            }

            // ── 3-second polling ──
            <% if (groupsEnabled && session.status === 'ACTIVE') { %>
            setInterval(async () => {
                try {
                    const res = await fetch(`/group/${sessionId}/state`);
                    if (!res.ok) return;
                    const data = await res.json();

                    if (data.memberCount !== initialMemberCount) { location.reload(); return; }

                    for (const [uid, keys] of Object.entries(data.completed)) {
                        if (uid === myUserId) continue;
                        localCompleted[uid] = new Set(keys);
                    }
                    applyAllStates();

                    for (const { i, userId } of memberIndex) {
                        const status = data.memberStatuses[userId];
                        const dot   = document.getElementById(`done-dot-${i}`);
                        const badge = document.getElementById(`done-badge-${i}`);
                        if (dot)   dot.style.display   = status === 'COMPLETED' ? 'inline-block' : 'none';
                        if (badge) badge.style.display  = status === 'COMPLETED' ? 'block'        : 'none';
                    }

                    if (data.sessionStatus === 'COMPLETED') {
                        document.getElementById('session-done-bar').style.display = 'block';
                    }
                } catch(e) {}
            }, 3000);
            <% } %>
        </script>

        <%- include('partials/bottom-nav', { mode: 'links', current: 'workouts', workoutsHref: '/group/' + session.id }) %>

    <% } %>

</body>
</html>
