<%
/* Variables:
   exercise   – CalisthenicsExercise
   todayTotal – number
*/
%>
<div id="cali-card-<%= exercise.id %>" class="cali-card">
    <div class="cali-top">
        <span class="cali-name"><%= exercise.name %></span>
        <form hx-post="/calisthenics/exercises/delete" hx-target="#cali-card-<%= exercise.id %>" hx-swap="delete"
              hx-confirm="Remove <%= exercise.name %>? This will delete all logs for this exercise."
              style="margin:0;">
            <input type="hidden" name="id" value="<%= exercise.id %>"/>
            <button type="submit" class="cali-remove" aria-label="Remove <%= exercise.name %>">
                <svg viewBox="0 0 24 24" style="stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                    <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/>
                </svg>
            </button>
        </form>
    </div>

    <div class="cali-stat">
        <form hx-post="/calisthenics/log" hx-target="#cali-card-<%= exercise.id %>" hx-swap="outerHTML"
              hx-vals="js:{loggedOn: new Date().toLocaleDateString('en-CA')}" style="margin:0;">
            <input type="hidden" name="exerciseId" value="<%= exercise.id %>"/>
            <input type="hidden" name="reps" value="-1"/>
            <button type="submit" class="cali-step" aria-label="Subtract 1 rep" <%= todayTotal <= 0 ? "disabled" : "" %>>−</button>
        </form>
        <div class="cali-total-wrap">
            <span class="cali-total"><%= todayTotal %></span>
            <span class="cali-total-label">reps today</span>
        </div>
        <form hx-post="/calisthenics/log" hx-target="#cali-card-<%= exercise.id %>" hx-swap="outerHTML"
              hx-vals="js:{loggedOn: new Date().toLocaleDateString('en-CA')}" style="margin:0;">
            <input type="hidden" name="exerciseId" value="<%= exercise.id %>"/>
            <input type="hidden" name="reps" value="1"/>
            <button type="submit" class="cali-step" aria-label="Add 1 rep">+</button>
        </form>
    </div>

    <div class="cali-quick-adds">
        <% [5, 10, 25].forEach(n => { %>
        <form hx-post="/calisthenics/log" hx-target="#cali-card-<%= exercise.id %>" hx-swap="outerHTML"
              hx-vals="js:{loggedOn: new Date().toLocaleDateString('en-CA')}" style="margin:0;flex:1;">
            <input type="hidden" name="exerciseId" value="<%= exercise.id %>"/>
            <input type="hidden" name="reps" value="<%= n %>"/>
            <button type="submit">+<%= n %></button>
        </form>
        <% }) %>
    </div>

    <button type="button" class="cali-edit-toggle" onclick="caliToggleEdit(<%= exercise.id %>)">Edit total</button>

    <form id="cali-edit-<%= exercise.id %>" class="cali-edit-row" hidden
          hx-post="/calisthenics/log/edit" hx-target="#cali-card-<%= exercise.id %>" hx-swap="outerHTML"
          hx-vals="js:{loggedOn: new Date().toLocaleDateString('en-CA')}">
        <input type="hidden" name="exerciseId" value="<%= exercise.id %>"/>
        <label for="cali-total-input-<%= exercise.id %>">Total</label>
        <input type="number" id="cali-total-input-<%= exercise.id %>" name="total" value="<%= todayTotal %>" min="0" max="100000" required/>
        <button type="submit">Save</button>
        <button type="button" class="text-action" onclick="caliToggleEdit(<%= exercise.id %>)">Cancel</button>
    </form>
</div>
