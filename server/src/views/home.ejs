<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Workout App</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏋️</text></svg>"/>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.3/dist/htmx.min.js"></script>
    <% if (music.configured.appleMusic) { %><script src="https://js-cdn.music.apple.com/musickit/v3/musickit.js"></script><% } %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* Base tokens; shared app-theme supplies the final palette. */
        :root {
            --lt-bg: #0D0D0D;
            --lt-surface: #1A1A1A;
            --lt-ink: #FFFFFF;
            --lt-ink-muted: #8A8A8E;
            --lt-accent: #FC4C02;
            --lt-line: #2A2A2A;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0f0f0f;
            color: #fff;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .tab-content {
            display: none;
            flex: 1;
            min-height: 0;
            overflow-y: auto;
            padding: 1.5rem 1rem 1.5rem;
        }

        .tab-content.active {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            overflow-y: auto;
        }

        .greeting {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .greeting span { color: #fc4c02; }

        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .stat-card {
            background: #1a1a1a;
            border-radius: 14px;
            padding: 1.1rem 1.1rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.75rem;
            color: #555;
            font-weight: 500;
        }

        .chart-card {
            background: #1a1a1a;
            border-radius: 14px;
            padding: 1.1rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .chart-title {
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #555;
        }

        .chart-wrap { position: relative; height: 190px; }

        .chart-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem 1rem;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.75rem;
            color: #888;
        }

        .legend-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .empty-chart {
            height: 190px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            color: #333;
        }

        .empty-chart svg {
            width: 36px;
            height: 36px;
            stroke: #2a2a2a;
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .empty-chart p { font-size: 0.82rem; }

        .card {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 1.1rem 1.2rem;
        }

        .music-provider-row { display:flex;gap:0.55rem;flex-wrap:wrap;margin-top:0.7rem; }
        .music-btn { display:inline-flex;align-items:center;justify-content:center;border:1px solid #303030;border-radius:9px;padding:0.55rem 0.75rem;color:#ddd;font-size:0.78rem;font-weight:700;text-decoration:none;cursor:pointer; }
        .music-btn.spotify { background:#12291b;color:#1ed760;border-color:#1d5531; }
        .music-btn.apple { background:#31151d;color:#fa586a;border-color:#67303d; }
        .playlist-row { display:grid;grid-template-columns:42px 1fr auto;gap:0.7rem;align-items:center;padding:0.65rem 0;border-top:1px solid #252525; }
        .playlist-art { width:42px;height:42px;border-radius:7px;object-fit:cover;background:#292929; }
        .playlist-title { font-size:0.86rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .playlist-provider { color:#666;font-size:0.7rem;margin-top:2px; }
        .playlist-actions { display:flex;gap:0.35rem; }
        .mini-btn { border:1px solid #333;border-radius:7px;color:#888;padding:0.35rem 0.45rem;font-size:0.68rem;font-weight:700; }
        .mini-btn.active { color:#4ade80;border-color:#31543d;background:#18251c; }
        .track-share { display:flex;gap:0.65rem;align-items:center;background:#121212;border:1px solid #292929;border-radius:10px;padding:0.6rem;margin-top:0.55rem;text-decoration:none; }
        .track-share img { width:44px;height:44px;border-radius:6px;object-fit:cover; }
        .track-share-title { font-size:0.82rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .track-share-artist { font-size:0.72rem;color:#777;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }

        .workout-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.9rem 1.1rem;
            background: #1a1a1a;
            border-radius: 10px;
        }

        .section-heading {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #444;
        }

        /* ── Profile tab, "Overview" sub-tab: mirrors friend-profile.ejs ── */
        .profile-card {
            background: var(--lt-surface); border-radius: 14px;
            padding: 1rem; margin-bottom: 0.75rem;
        }
        .lift-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            background: var(--lt-surface);
            border-radius: 12px;
            margin-bottom: 0.5rem;
        }
        .lift-name { font-size: 0.95rem; font-weight: 600; color: var(--lt-ink); }
        .lift-meta { font-size: 0.8rem; color: var(--lt-ink-muted); text-align: right; }
        .avatar { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; }
        .avatar-placeholder {
            width: 60px; height: 60px; border-radius: 50%; background: var(--lt-line);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 1.4rem; color: var(--lt-ink-muted);
        }
        .now-playing { display:flex;gap:0.8rem;align-items:center;border:1px solid #1E7A4C55;background:#12271c; }
        .music-art { width:54px;height:54px;border-radius:8px;object-fit:cover;background:var(--lt-line);flex-shrink:0; }
        .live { display:inline-flex;align-items:center;gap:0.35rem;color:#4ade80;font-size:0.67rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em; }
        .live::before { content:"";width:6px;height:6px;border-radius:50%;background:#4ade80;box-shadow:0 0 8px #4ade8088; }
        .playlist { display:flex;align-items:center;gap:0.75rem;color:inherit;text-decoration:none; }
        .playlist-copy { min-width:0;flex:1; }
        .playlist-name { font-size:0.92rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--lt-ink); }
        .playlist-meta { color:var(--lt-ink-muted);font-size:0.75rem;margin-top:3px; }

        /* Home feed and profile base styles. */
        #tab-home, #tab-profile {
            background: var(--lt-bg);
            color: var(--lt-ink);
            font-family: 'Public Sans', -apple-system, sans-serif;
        }
        #tab-home .page-title, #tab-profile .page-title {
            font-weight: 800;
            font-size: 1.6rem;
            letter-spacing: -0.5px;
            color: var(--lt-ink);
        }
        #tab-profile .section-heading, #tab-home .section-heading {
            color: var(--lt-ink-muted);
        }
        #tab-profile .icon-btn { color: var(--lt-ink-muted); }

        /* Sub-tab switcher, reused for Profile's Overview/Dashboard — an
           underline tab strip (matches Strava's Progress/Activities/Gallery
           tabs), not a segmented pill. */
        .lt-subtabs {
            display: flex; gap: 1.5rem; border-bottom: 1px solid var(--lt-line);
        }
        .lt-subtabs button {
            padding: 0 0 0.6rem; border: none; border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            font-size: 0.88rem; font-weight: 700; cursor: pointer;
            background: transparent; color: var(--lt-ink-muted);
            font-family: inherit; transition: color 0.15s, border-color 0.15s;
        }
        .lt-subtabs button.active { color: var(--lt-ink); border-bottom-color: var(--lt-accent); }

        /* Feed */
        #tab-home .thread-feed { gap: 0.85rem; }
        #tab-home .post-card {
            display: flex; gap: 0.75rem; padding: 1rem;
            background: var(--lt-surface); border-radius: 14px;
        }
        #tab-home .post-avatar, #tab-home .post-avatar-placeholder { background: var(--lt-line); color: var(--lt-ink-muted); }
        #tab-home .post-author { color: var(--lt-ink); }
        #tab-home .post-time { color: var(--lt-ink-muted); }
        #tab-home .post-delete { color: #555; }
        #tab-home .post-delete:hover { color: var(--lt-accent); }
        #tab-home .post-content { color: var(--lt-ink); }
        #tab-home .reply-btn { color: var(--lt-ink-muted); }
        #tab-home .reply-btn:active { color: var(--lt-accent); }
        #tab-home .track-share { background: var(--lt-bg); border: 1px solid var(--lt-line); }
        #tab-home .track-share-artist { color: var(--lt-ink-muted); }
        #tab-home .empty-feed { color: var(--lt-ink-muted); }
        #tab-home .empty-feed div:last-child { color: #555; }

        /* PR post: a small orange badge, not a giant orange number — Strava
           keeps stat values in plain bold white and reserves orange for
           interactive/branded elements (pills, badges, active states). */
        #tab-home .pr-badge-row { display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; margin: 0.35rem 0 0.15rem; }
        #tab-home .pr-badge {
            background: var(--lt-accent); color: #fff; font-size: 0.62rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: 0.05em; padding: 0.18rem 0.55rem; border-radius: 999px;
        }
        #tab-home .pr-stat { font-size: 1.3rem; font-weight: 800; color: var(--lt-ink); }
        #tab-home .pr-lift { font-size: 0.8rem; color: var(--lt-ink-muted); }

        /* Composer (shared markup with the Cals composer, which stays dark —
           scoped to #tab-home so only the feed composer picks up the new look) */
        #tab-home .post-composer { background: var(--lt-surface); border: 1px solid var(--lt-line); }
        #tab-home .post-composer textarea { color: var(--lt-ink); }
        #tab-home .post-composer textarea::placeholder { color: #555; }
        #tab-home .btn-post { background: var(--lt-accent); }

        /* Dashboard sub-tab (inside Profile): the old Home content, moved */
        #tab-profile .stat-card { background: var(--lt-surface); }
        #tab-profile .stat-value { color: var(--lt-ink); }
        #tab-profile .stat-label { color: var(--lt-ink-muted); }
        #tab-profile .chart-card { background: var(--lt-surface); }
        #tab-profile .chart-title { color: var(--lt-ink-muted); }
        #tab-profile .empty-chart { color: #555; }
        #tab-profile .empty-chart svg { stroke: var(--lt-line); }
        #tab-profile .legend-item { color: var(--lt-ink-muted); }
        #tab-profile .cal-nav { background: var(--lt-bg); }
        #tab-profile .cal-nav svg { stroke: var(--lt-ink-muted); }
        #tab-profile .cal-today-link { color: var(--lt-accent); }
        #tab-profile .cal-weekdays span { color: var(--lt-ink-muted); }
        /* Circular day cells with a ring on today, matching Strava's calendar
           sheet rather than this app's original rounded-square cells. */
        #tab-profile .cal-day { background: var(--lt-bg); border-radius: 50%; aspect-ratio: 1; padding: 0; justify-content: center; }
        #tab-profile .cal-day.today { box-shadow: inset 0 0 0 1.5px var(--lt-accent); }
        #tab-profile .cal-day.today .cal-num { color: var(--lt-accent); }
        #tab-profile .cal-day.selected { background: var(--lt-line); }
        #tab-profile .cal-day.future .cal-num { color: #444; }
        #tab-profile .cal-day.outside .cal-num { color: #333; }
        #tab-profile .cal-num { color: var(--lt-ink); }
        #tab-profile .cal-detail { background: var(--lt-bg); }
        #tab-profile .cal-detail-date { color: var(--lt-ink-muted); }
        #tab-profile .cal-empty { color: #555; }
        #tab-profile .cal-item-title { color: var(--lt-ink); }
        #tab-profile .cal-item-detail { color: var(--lt-ink-muted); }

        .btn-remove {
            background: none;
            border: 1px solid #2a2a2a;
            color: #e05252;
            border-radius: 6px;
            padding: 0.3rem 0.65rem;
            font-size: 0.75rem;
            cursor: pointer;
        }

        .add-form { display: flex; gap: 0.5rem; }

        .add-form input {
            flex: 1;
            background: #111;
            border: 1px solid #2a2a2a;
            border-radius: 8px;
            color: #fff;
            font-size: 0.9rem;
            padding: 0.65rem 0.9rem;
            outline: none;
        }

        .add-form input:focus { border-color: #fc4c02; }

        .add-form button {
            background: #fc4c02;
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 0.65rem 1rem;
            cursor: pointer;
        }


        #tab-social.active {
            overflow-y: hidden;
            padding-bottom: 0;
            gap: 0.75rem;
        }

        #tab-cals.active {
            display: block;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        #tab-cals.active > * + * {
            margin-top: 1rem;
        }

        .social-thread {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 0;
        }

        .thread-feed {
            flex: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        .social-friends-panel {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            padding-bottom: 1rem;
        }

        .post-composer {
            flex-shrink: 0;
            background: #1a1a1a;
            border-radius: 14px;
            padding: 0.5rem 0.65rem;
            margin-bottom: 0.75rem;
        }

        .post-composer textarea {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 0.9rem;
            font-family: inherit;
            resize: none;
            outline: none;
            line-height: 1.5;
            min-height: 36px;
            max-height: 120px;
            overflow-y: auto;
            padding: 0.2rem 0;
        }

        .post-composer textarea::placeholder { color: #444; }

        .composer-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-post {
            background: #fc4c02;
            border: none;
            border-radius: 20px;
            color: #fff;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 0.35rem 0.9rem;
            cursor: pointer;
            flex-shrink: 0;
        }

        .btn-log {
            background: #4ade80;
            border: none;
            border-radius: 20px;
            color: #0a0a0a;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 0.35rem 0.9rem;
            cursor: pointer;
            flex-shrink: 0;
        }

        .btn-log:disabled {
            background: #1a2a1a;
            color: #2a4a2a;
            cursor: not-allowed;
        }

        .cal-num-input {
            width: 68px;
            background: transparent;
            border: none;
            border-left: 1px solid #2a2a2a;
            color: #4ade80;
            font-size: 0.85rem;
            padding: 0.2rem 0.5rem;
            outline: none;
            text-align: center;
            flex-shrink: 0;
        }

        .cal-num-input::placeholder { color: #2a4a2a; }

        .post-card {
            display: flex;
            gap: 0.75rem;
            padding: 1rem 0;
            border-bottom: 1px solid #1a1a1a;
        }

        .post-card:last-child { border-bottom: none; }

        .post-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
            background: #2a2a2a;
        }

        .post-avatar-placeholder {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #2a2a2a;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #555;
            font-size: 0.8rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .post-body { flex: 1; min-width: 0; }

        .post-meta {
            display: flex;
            align-items: baseline;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }

        .post-author {
            font-size: 0.88rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .post-time {
            font-size: 0.75rem;
            color: #555;
            flex-shrink: 0;
        }

        .post-delete {
            margin-left: auto; color: #666; background: none; border: none;
            padding: 0 0.2rem; font-size: 0.72rem; cursor: pointer;
        }
        .post-delete:hover { color: #f87171; }

        .post-content {
            font-size: 0.9rem;
            color: #ccc;
            line-height: 1.5;
            word-break: break-word;
        }

        .reply-btn {
            display: inline-flex; align-items: center; gap: 0.3rem;
            color: #555; font-size: 0.78rem; font-weight: 600;
            text-decoration: none; margin-top: 0.5rem;
        }
        .reply-btn:active { color: #fc4c02; }

        .request-card {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #1a1a1a;
            border-radius: 12px;
            padding: 0.85rem 1rem;
        }

        .request-info { flex: 1; min-width: 0; }

        .request-name {
            font-size: 0.9rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .request-email {
            font-size: 0.72rem;
            color: #555;
        }

        .request-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }

        .btn-accept {
            background: #fc4c02;
            border: none;
            border-radius: 6px;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.35rem 0.7rem;
            cursor: pointer;
        }

        .btn-decline {
            background: none;
            border: 1px solid #2a2a2a;
            border-radius: 6px;
            color: #888;
            font-size: 0.75rem;
            padding: 0.35rem 0.7rem;
            cursor: pointer;
        }

        .empty-feed {
            text-align: center;
            padding: 2rem 0;
            color: #444;
            font-size: 0.875rem;
            line-height: 1.6;
        }

        nav {
            display: flex;
            background: #111;
            border-top: 1px solid #222;
            padding-bottom: env(safe-area-inset-bottom);
        }

        nav button {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 0.75rem 0.5rem;
            background: none;
            border: none;
            color: #555;
            font-size: 0.7rem;
            font-weight: 500;
            cursor: pointer;
            transition: color 0.15s;
        }

        nav button.active { color: #fc4c02; }

        nav button svg {
            width: 24px;
            height: 24px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ── Month activity calendar ── */
        .cal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
        }

        .cal-nav {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: #111;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .cal-nav svg {
            width: 15px;
            height: 15px;
            stroke: #777;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .cal-label {
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .cal-today-link {
            font-size: 0.7rem;
            font-weight: 700;
            color: #fc4c02;
            text-decoration: none;
            margin-left: 0.4rem;
        }

        .cal-weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
            margin-bottom: 4px;
        }

        .cal-weekdays span {
            text-align: center;
            font-size: 0.58rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #555;
        }

        .cal-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 4px;
        }

        .cal-day {
            background: #111;
            border: none;
            border-radius: 10px;
            padding: 0.4rem 0 0.35rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            cursor: pointer;
            transition: background 0.15s;
        }

        .cal-day.future .cal-num { color: #3d3d3d; }

        .cal-day.today .cal-num { color: #fc4c02; }

        .cal-day.selected { background: #1c2b40; }

        .cal-day.outside { background: transparent; }
        .cal-day.outside .cal-num { color: #3a3a3a; }

        .cal-num {
            font-size: 0.72rem;
            font-weight: 600;
            line-height: 1.25;
            color: #ccc;
        }

        .cal-dots {
            display: flex;
            gap: 2px;
            min-height: 5px;
        }

        .cal-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            display: block;
        }

        .cal-dot.main { background: #4ade80; }
        .cal-dot.aux { background: #fb923c; }
        .cal-dot.cals { background: #fc4c02; }
        .cal-dot.weight { background: #a78bfa; }

        .cal-detail {
            background: #111;
            border-radius: 10px;
            padding: 0.65rem 0.8rem 0.6rem;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .cal-detail-date {
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #555;
        }

        .cal-empty {
            font-size: 0.8rem;
            color: #444;
            padding-bottom: 0.1rem;
        }

        .cal-item {
            display: flex;
            align-items: center;
            gap: 0.55rem;
        }

        .cal-item-icon {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .cal-item-icon.main { stroke: #4ade80; }
        .cal-item-icon.aux { stroke: #fb923c; }
        .cal-item-icon.cals { stroke: #fc4c02; }
        .cal-item-icon.weight { stroke: #a78bfa; }

        .cal-item-title {
            font-size: 0.85rem;
            font-weight: 500;
            color: #ddd;
            flex-shrink: 0;
        }

        .cal-item-detail {
            font-size: 0.75rem;
            color: #666;
            margin-left: auto;
            text-align: right;
        }

        .icon-btn {
            background: none;
            border: none;
            color: #888;
            cursor: pointer;
            padding: 0.4rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .icon-btn svg {
            width: 22px;
            height: 22px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .stat-card.clickable { cursor: pointer; }
        .stat-card.clickable:active { opacity: 0.7; }

        /* ── Centered modal (body weight) ── */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9998;
            background: rgba(0,0,0,0.7);
            align-items: center;
            justify-content: center;
            padding: 1.25rem;
        }

        .modal-overlay.show { display: flex; }

        .modal-card {
            background: #171717;
            border-radius: 18px;
            padding: 1.5rem;
            max-width: 360px;
            width: 100%;
            max-height: 85vh;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            border: 1px solid #2a2a2a;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-title { font-size: 1.05rem; font-weight: 800; }

        .modal-close {
            background: none;
            border: none;
            color: #888;
            font-size: 1.4rem;
            cursor: pointer;
            line-height: 1;
            padding: 0;
        }

        /* ── Full-screen settings page ── */
        .settings-page {
            display: none;
            position: fixed;
            inset: 0;
            background: #0f0f0f;
            z-index: 9998;
            flex-direction: column;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        .settings-page.show { display: flex; }

        .settings-page-header {
            position: sticky;
            top: 0;
            z-index: 1;
            background: #0f0f0f;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.9rem 1rem;
            border-bottom: 1px solid #1a1a1a;
        }

        .settings-page-body {
            padding: 1.25rem 1rem 2rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
    </style>
    <%- include('partials/app-theme') %>
</head>
<body class="app-home">

    <section class="tab-content active" id="tab-home">
        <header class="app-toolbar">
            <button class="round-action" onclick="document.getElementById('create-dialog').showModal()" aria-label="Create"><%- include('partials/icon',{name:'plus'}) %></button>
            <button class="round-action" onclick="openActivitySearch()" aria-label="Search activities"><%- include('partials/icon',{name:'search'}) %></button>
            <h1 class="app-wordmark">WORKOUT<span>.</span></h1>
            <button class="round-action" onclick="switchTab('social')" aria-label="Friends"><%- include('partials/icon',{name:'friends'}) %></button>
            <button class="round-action notification-action" onclick="document.getElementById('notifications-dialog').showModal()" aria-label="Notifications"><%- include('partials/icon',{name:'bell'}) %><% if(pendingRequests.length) { %><i class="notification-dot"></i><% } %></button>
        </header>
        <div class="streak-banner">
            <div class="section-line"><h2>Your streak</h2><button class="text-action" onclick="openCalendar()">View calendar</button></div>
            <div class="streak-body">
                <div class="streak-flame <%= training.streak ? 'has-streak' : '' %>"><%- include('partials/icon',{name:'flame'}) %><strong><%= training.streak %></strong><span><%= training.streak === 1 ? 'Week' : 'Weeks' %></span></div>
                <p><%= training.streak ? 'Keep showing up. Your next session keeps the momentum going.' : 'Start your streak by logging a workout.' %></p>
                <button class="primary-action" onclick="startWorkout()"><%= activeSessionId ? 'Resume' : 'Record now' %></button>
            </div>
            <div class="week-strip"><% training.days.forEach(d => { %><div class="week-day <%= d.active ? 'done' : '' %> <%= d.today ? 'today' : '' %>" title="<%= d.date %><%= d.active ? ': workout logged' : '' %>"><i></i><span><%= d.label %></span></div><% }) %></div>
        </div>
        <div class="section-line feed-heading"><h2>Following</h2><span>You + your training circle</span></div>
        <div class="thread-feed">
            <% if (!feedPosts.length) { %>
            <div class="empty-state"><%- include('partials/icon',{name:'lift'}) %><h2>Every rep has a story.</h2><p>Log a personal record, share a session, and cheer on your friends. Your training story starts here.</p><button class="primary-action" onclick="startWorkout()"><%= totalSessions ? 'Record a workout' : 'Log your first workout' %></button><button class="text-action" onclick="switchTab('social')">Find your training circle →</button></div>
            <% } %>
            <% feedPosts.forEach(post => { %><%- include('partials/activity-post',{post,user}) %><% }) %>
        </div>
        <dialog id="composer-dialog" class="app-dialog" aria-labelledby="composer-title">
        <div class="dialog-header"><button class="round-action" onclick="document.getElementById('composer-dialog').close()" aria-label="Close composer"><%- include('partials/icon',{name:'close'}) %></button><h2 id="composer-title">Create a post</h2><button class="primary-action" type="submit" form="postForm">Publish</button></div>
        <div class="post-composer">
            <form action="/social/post" method="post" enctype="multipart/form-data" id="postForm">
                <div id="imagePreview" style="display:none;margin-bottom:0.4rem;">
                    <img id="previewImg" src="" alt=""
                         style="width:100%;height:auto;max-height:180px;object-fit:contain;background:#000;border-radius:8px;"/>
                    <button type="button" onclick="clearImage()"
                            style="background:none;border:none;color:var(--lt-accent);font-size:0.75rem;
                                   cursor:pointer;margin-top:0.2rem;">Remove image</button>
                </div>
                <div class="composer-row">
                    <input type="file" name="image" id="actualImageInput" style="display:none;" accept="image/jpeg">
                    <label style="cursor:pointer;flex-shrink:0;display:flex;align-items:center;">
                        <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:var(--lt-ink-muted);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                            <path d="M21 15l-5-5L5 21"/>
                        </svg>
                        <input type="file" id="imageInput"
                               accept="image/jpeg,image/png,image/gif,image/webp"
                               style="display:none;" onchange="previewImage(this)"/>
                    </label>
                    <label style="cursor:pointer;flex-shrink:0;display:flex;align-items:center;">
                        <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:var(--lt-ink-muted);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                            <circle cx="12" cy="13" r="4"/>
                        </svg>
                        <input type="file" id="cameraInput" accept="image/*" capture="environment"
                               style="display:none;" onchange="previewImage(this)"/>
                    </label>
                    <textarea name="content" placeholder="What’s going on?" aria-label="Post text" maxlength="280" rows="1"></textarea>
                    <span class="muted" style="margin-left:auto;font-size:12px">Share with your friends</span>
                </div>
            </form>
        </div>
        </dialog>
    </section>

    <section class="tab-content" id="tab-workouts">
        <div class="section-line"><h1 style="font-size:28px">Record</h1><button class="round-action" onclick="openSettings()" aria-label="Workout settings"><%- include('partials/icon',{name:'settings'}) %></button></div>
        <div class="workout-intro"><span class="eyebrow">Your 5/3/1 program</span><h2>Make today count.</h2><p>Pick your main lift. Your working sets, progression, and accessory exercises are ready when you are.</p></div>
        <div class="section-heading">Choose your lift</div>

        <% coreWorkouts.forEach(w => { %>
        <% if (weekLabels[w.id]) { %>
        <!-- Configured lift: POST directly to create/resume session -->
        <form action="/group/create" method="post" style="margin-bottom:0.3rem;">
            <input type="hidden" name="liftId" value="<%= w.id %>">
            <button type="submit" class="workout-row"
                    style="width:100%;background:none;border:none;text-align:left;cursor:pointer;color:inherit;">
                <div style="display:flex;flex-direction:column;gap:2px;">
                    <span style="font-size:0.95rem;font-weight:500;"><%= w.name %></span>
                    <span style="font-size:0.75rem;color:#fc4c02;font-weight:600;"><%= weekLabels[w.id] %></span>
                </div>
                <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:#555;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;">
                    <path d="M9 18l6-6-6-6"/>
                </svg>
            </button>
        </form>
        <% } else { %>
        <!-- Unconfigured lift: tap to expand TM input -->
        <div style="margin-bottom:0.3rem;">
            <button type="button" onclick="toggleHostTM(<%= w.id %>)" class="workout-row"
                    style="width:100%;background:none;border:none;text-align:left;cursor:pointer;color:inherit;">
                <div style="display:flex;flex-direction:column;gap:2px;">
                    <span style="font-size:0.95rem;font-weight:500;"><%= w.name %></span>
                    <span style="font-size:0.75rem;color:#444;">Not started</span>
                </div>
                <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:#555;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;">
                    <path d="M9 18l6-6-6-6"/>
                </svg>
            </button>
            <form id="host-tm-<%= w.id %>" action="/group/create" method="post"
                  style="display:none;background:#1a1a1a;border-radius:0 0 10px 10px;padding:0.75rem;margin-top:-2px;">
                <input type="hidden" name="liftId" value="<%= w.id %>">
                <div style="font-size:0.75rem;color:#555;margin-bottom:0.5rem;">Training max for <%= w.name %>:</div>
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    <input type="number" name="trainingMax" placeholder="e.g. 185" step="any" min="45" required
                           style="background:#111;border:1px solid #2a2a2a;border-radius:8px;color:#fff;font-size:0.95rem;font-weight:700;padding:0.4rem 0.65rem;outline:none;width:130px;">
                    <span style="font-size:0.8rem;color:#555;flex-shrink:0;">lbs</span>
                    <button type="submit"
                            style="flex:1;background:#fc4c02;border:none;border-radius:8px;color:#fff;font-size:0.88rem;font-weight:700;padding:0.45rem;cursor:pointer;">
                        Start →
                    </button>
                </div>
            </form>
        </div>
        <% } %>
        <% }) %>

        <% if (coreWorkouts.length === 0) { %>
            <p style="text-align:center;margin-top:2rem;color:#555;font-size:0.9rem;">Add your first lift in Profile → Settings.</p>
        <% } %>

        <!-- Join a friend's room -->
        <% if (groupsEnabled) { %>
        <a href="/group/rooms" style="display:flex;align-items:center;gap:1rem;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:14px;padding:1.1rem 1rem;margin-top:1rem;text-decoration:none;color:inherit;">
            <div style="width:42px;height:42px;border-radius:10px;background:#1a1e2e;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0;">👥</div>
            <div>
                <div style="font-size:0.95rem;font-weight:700;">Join a Friend's Room</div>
                <div style="font-size:0.78rem;color:#555;margin-top:2px;">See who's hosting right now</div>
            </div>
        </a>
        <% } %>
    </section>

    <section class="tab-content" id="tab-profile">
        <header class="app-toolbar">
            <button class="round-action" onclick="document.getElementById('create-dialog').showModal()" aria-label="Create"><%- include('partials/icon',{name:'plus'}) %></button>
            <span class="toolbar-space"></span>
            <button class="round-action" onclick="openActivitySearch()" aria-label="Search your activities"><%- include('partials/icon',{name:'search'}) %></button>
            <button class="round-action" onclick="openSettings()" aria-label="Settings"><%- include('partials/icon',{name:'settings'}) %></button>
        </header>
        <div class="profile-identity">
            <% if (user.pictureUrl) { %><img src="<%= user.pictureUrl %>" class="avatar" alt=""><% } else { %><div class="avatar-placeholder"><%= user.displayName.charAt(0).toUpperCase() %></div><% } %>
            <div><h1><%= user.displayName %></h1><p><%= totalSessions %> <%= totalSessions === 1 ? 'activity' : 'activities' %></p></div>
        </div>
        <div class="profile-connections"><button onclick="switchTab('social')"><%= friends.length %> <%= friends.length === 1 ? 'friend' : 'friends' %></button><span>·</span><span><%= training.totalPrs %> personal records</span></div>
        <div class="profile-buttons"><button class="outline-action" onclick="openSettings()">Edit profile</button><button class="outline-action" onclick="shareProfile()">Share profile</button></div>
        <div class="lt-subtabs" role="tablist" aria-label="Your profile">
            <% [{id:'dashboard',label:'Progress',icon:'progress'},{id:'activities',label:'Activities',icon:'activity'},{id:'gallery',label:'Gallery',icon:'gallery'},{id:'overview',label:'More',icon:'more'}].forEach(t => { %>
            <button id="profile-subtab-btn-<%= t.id %>" class="<%= t.id === 'dashboard' ? 'active' : '' %>" role="tab" aria-selected="<%= t.id === 'dashboard' %>" aria-controls="profile-subtab-<%= t.id %>" onclick="switchProfileSubTab('<%= t.id %>')"><%- include('partials/icon',{name:t.icon}) %><%= t.label %></button>
            <% }) %>
        </div>
        <div id="profile-subtab-overview" class="profile-panel" role="tabpanel" aria-labelledby="profile-subtab-btn-overview" style="display:none">
            <button class="more-link" onclick="switchProfileSubTab('dashboard')"><%- include('partials/icon',{name:'progress'}) %><span>Statistics<small><%= totalSessions %> sessions · <%= training.totalPrs %> personal records</small></span><%- include('partials/icon',{name:'chevron'}) %></button>
            <button class="more-link" onclick="switchProfileSubTab('activities')"><%- include('partials/icon',{name:'activity'}) %><span>Training log<small>Your complete workout history</small></span><%- include('partials/icon',{name:'chevron'}) %></button>
            <button class="more-link" onclick="document.getElementById('my-posts-dialog').showModal()"><%- include('partials/icon',{name:'message'}) %><span>Posts<small><%= myPosts.length %> shared moments</small></span><%- include('partials/icon',{name:'chevron'}) %></button>
            <div class="milestone-card"><%- include('partials/icon',{name:'trophy'}) %><h3>Build your next streak.</h3><p>Big progress starts with showing up. Log a workout each week and watch your consistency grow.</p><button class="primary-action" onclick="startWorkout()">Record a workout</button></div>
        <% if (nowPlaying) { %>
        <div>
            <div class="section-heading" style="margin-bottom:0.5rem;">Live workout</div>
            <a class="profile-card now-playing" href="<%= nowPlaying.externalUrl || '#' %>" <%= nowPlaying.externalUrl ? 'target="_blank" rel="noopener"' : '' %> style="text-decoration:none;">
                <% if (nowPlaying.artworkUrl) { %><img class="music-art" src="<%= nowPlaying.artworkUrl %>" alt=""/><% } else { %><div class="music-art" style="display:flex;align-items:center;justify-content:center;">♫</div><% } %>
                <div style="min-width:0;">
                    <div class="live">Working out · <%= nowPlaying.liftName %></div>
                    <div class="playlist-name" style="margin-top:4px;"><%= nowPlaying.title %></div>
                    <div class="playlist-meta"><%= nowPlaying.artist %> · <%= nowPlaying.provider === 'SPOTIFY' ? 'Spotify' : 'Apple Music' %></div>
                </div>
            </a>
        </div>
        <% } %>

        <% const publishedPlaylists = music.enabled ? music.playlists.filter(p => p.isPublished) : []; %>
        <% if (publishedPlaylists.length > 0) { %>
        <div>
            <div class="section-heading" style="margin-bottom:0.5rem;">Workout playlists</div>
            <% publishedPlaylists.forEach(playlist => { %>
                <a class="profile-card playlist" href="<%= playlist.externalUrl || '#' %>" <%= playlist.externalUrl ? 'target="_blank" rel="noopener"' : '' %>>
                    <% if (playlist.artworkUrl) { %><img class="music-art" src="<%= playlist.artworkUrl %>" alt=""/><% } else { %><div class="music-art" style="display:flex;align-items:center;justify-content:center;">♫</div><% } %>
                    <div class="playlist-copy">
                        <div class="playlist-name"><%= playlist.name %></div>
                        <div class="playlist-meta"><%= playlist.provider === 'SPOTIFY' ? 'Spotify' : 'Apple Music' %> · Published playlist</div>
                    </div>
                    <span style="color:var(--lt-ink-muted);">↗</span>
                </a>
            <% }) %>
        </div>
        <% } %>

        <% if (currentWeight) { %>
        <div>
            <div class="section-heading" style="margin-bottom:0.5rem;">Body weight</div>
            <div class="profile-card" style="display:flex;align-items:baseline;gap:0.4rem;">
                <span style="font-size:1.75rem;font-weight:800;letter-spacing:-1px;"><%= currentWeight %></span>
                <span style="font-size:0.85rem;color:var(--lt-ink-muted);">lbs</span>
            </div>
        </div>
        <% } %>

        <div>
            <div class="section-heading" style="margin-bottom:0.5rem;">Lifts</div>
            <% if (coreWorkouts.length === 0) { %>
                <div style="color:var(--lt-ink-muted);font-size:0.9rem;padding:0.5rem 0;">No lifts configured yet.</div>
            <% } %>
            <% coreWorkouts.forEach(w => { %>
                <div class="lift-row">
                    <div class="lift-name"><%= w.name %></div>
                    <div class="lift-meta">
                        <% if (w.trainingMax) { %><div><%= w.trainingMax %> lbs TM</div><% } %>
                        <% if (w.currentWeek) { %><div>Week <%= w.currentWeek %></div><% } %>
                        <% if (!w.trainingMax) { %><div style="color:var(--lt-ink-muted);">Not configured</div><% } %>
                    </div>
                </div>
            <% }) %>
        </div>
        </div>

        <!-- Dashboard: the old Home tab content, moved here so the feed can
             be the front door. -->
        <div id="profile-subtab-dashboard" class="profile-panel" role="tabpanel" aria-labelledby="profile-subtab-btn-dashboard" style="display:flex;flex-direction:column;gap:1rem;">
            <%- include('partials/training-progress') %>
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-value"><%= totalSessions %></div>
                    <div class="stat-label">Sessions logged</div>
                </div>
                <div class="stat-card clickable" onclick="openWeightModal()" role="button" tabindex="0">
                    <div class="stat-value"><%= currentWeight ? currentWeight + ' lbs' : '—' %></div>
                    <div class="stat-label">Body weight</div>
                </div>
            </div>

            <!-- Month activity calendar -->
            <dialog id="calendar-dialog" class="app-dialog" aria-labelledby="calendar-title">
            <div class="dialog-header"><h2 id="calendar-title">Training calendar</h2><button class="round-action" onclick="document.getElementById('calendar-dialog').close()" aria-label="Close calendar"><%- include('partials/icon',{name:'close'}) %></button></div>
            <div class="chart-card" id="month-calendar">
                <div class="cal-header">
                    <a href="/?mo=<%= calendar.prevMo %>#tab-profile-calendar" class="cal-nav" aria-label="Previous month">
                        <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
                    </a>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:1px;">
                        <div style="display:flex;align-items:baseline;">
                            <span class="chart-title">Activity</span>
                            <% if (!calendar.isCurrentMonth) { %>
                                <a href="/#tab-profile-calendar" class="cal-today-link">Today</a>
                            <% } %>
                        </div>
                        <span class="cal-label"><%= calendar.label %></span>
                    </div>
                    <a href="/?mo=<%= calendar.nextMo %>#tab-profile-calendar" class="cal-nav" aria-label="Next month">
                        <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
                    </a>
                </div>

                <div class="cal-weekdays">
                    <% calendar.weekdays.forEach(l => { %><span><%= l %></span><% }) %>
                </div>

                <div class="cal-grid">
                    <% calendar.days.forEach(d => { %>
                    <button type="button"
                            id="cal-day-<%= d.iso %>"
                            class="cal-day<%= d.inMonth ? '' : ' outside' %><%= d.isToday ? ' today' : '' %><%= d.isFuture ? ' future' : '' %><%= calendar.selectedIso === d.iso ? ' selected' : '' %>"
                            onclick="toggleCalDay('<%= d.iso %>')">
                        <span class="cal-num"><%= d.dayNum %></span>
                        <span class="cal-dots">
                            <% d.items.slice(0, 3).forEach(it => { %><i class="cal-dot <%= it.kind %>"></i><% }) %>
                        </span>
                    </button>
                    <% }) %>
                </div>

                <% calendar.days.forEach(d => { %>
                <div id="cal-detail-<%= d.iso %>" class="cal-detail"
                     style="display:<%= calendar.selectedIso === d.iso ? 'block' : 'none' %>;">
                    <div class="cal-detail-date">
                        <%= d.isToday ? 'Today · ' : '' %><%= d.detailDate %>
                    </div>
                    <% if (d.items.length === 0) { %>
                        <div class="cal-empty">No activity logged.</div>
                    <% } else { %>
                        <% d.items.forEach(it => {
                               const iconPath = it.kind === 'main'
                                   ? '<path d="M6.5 6.5v11"/><path d="M17.5 6.5v11"/><path d="M3 9.5v5"/><path d="M21 9.5v5"/><path d="M6.5 12h11"/>'
                                   : it.kind === 'aux'
                                   ? '<circle cx="12" cy="12" r="9"/><path d="M12 8v8"/><path d="M8 12h8"/>'
                                   : it.kind === 'cals'
                                   ? '<path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>'
                                   : '<path d="M3 12h4l3-9 4 18 3-9h4"/>';
                        %>
                        <div class="cal-item">
                            <svg class="cal-item-icon <%= it.kind %>" viewBox="0 0 24 24"><%- iconPath %></svg>
                            <span class="cal-item-title"><%= it.title %></span>
                            <% if (it.detail) { %><span class="cal-item-detail"><%= it.detail %></span><% } %>
                        </div>
                        <% }) %>
                    <% } %>
                </div>
                <% }) %>
            </div>
            </dialog>

            <div class="chart-card">
                <div class="chart-title">Training Max Progression</div>
                <% if (chartDatasets.length > 0) { %>
                    <div class="chart-wrap">
                        <canvas id="progressChart"></canvas>
                    </div>
                    <div class="chart-legend" id="chartLegend"></div>
                <% } else { %>
                    <div class="empty-chart">
                        <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        <p>Complete a workout to see your progress</p>
                    </div>
                <% } %>
            </div>

            <div class="chart-card">
                <div class="chart-title">Daily Calories (30 days)</div>
                <% if (calChartData.length > 0) { %>
                    <div class="chart-wrap">
                        <canvas id="calChart"></canvas>
                    </div>
                <% } else { %>
                    <div class="empty-chart">
                        <svg viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/></svg>
                        <p>Log some food to see your calorie history</p>
                    </div>
                <% } %>
            </div>

            <div class="chart-card">
                <div class="chart-title">Body Weight (90 days)</div>
                <% if (weightChartData.length > 0) { %>
                    <div class="chart-wrap">
                        <canvas id="weightChart"></canvas>
                    </div>
                <% } else { %>
                    <div class="empty-chart">
                        <svg viewBox="0 0 24 24"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
                        <p>Log your weight to track it over time</p>
                    </div>
                <% } %>
            </div>
        </div>
        <div id="profile-subtab-activities" class="profile-panel" role="tabpanel" aria-labelledby="profile-subtab-btn-activities" style="display:none">
            <label class="search-field"><%- include('partials/icon',{name:'search'}) %><input id="activity-search" type="search" placeholder="Search your activities" aria-label="Search your activities" oninput="filterActivities()"></label>
            <div class="activity-filters"><button class="filter-chip active" data-filter="all" aria-pressed="true" onclick="setActivityFilter('all',this)">All activities</button><button class="filter-chip" data-filter="pr" aria-pressed="false" onclick="setActivityFilter('pr',this)">Personal records</button></div>
            <% activityLogs.forEach(log => { %>
            <article class="activity-card training-log" data-search="<%= log.lift.name.toLowerCase() %> <%= log.completedOn %>" data-pr="<%= log.isPr %>">
                <div class="activity-author"><%- include('partials/icon',{name:'lift'}) %><div class="activity-author-copy"><strong><%= user.displayName %></strong><small><%= new Date(log.completedOn + 'T12:00:00Z').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'}) %> · Week <%= log.week %></small></div><% if(log.isPr) { %><span class="record-tag"><%- include('partials/icon',{name:'trophy'}) %> PR</span><% } %></div>
                <h2><%= log.lift.name %></h2>
                <div class="activity-stats"><div><small>Top set</small><strong><%= log.topSetWeight ?? '—' %> <span>lbs</span></strong></div><div><small>AMRAP reps</small><strong><%= log.amrapReps %></strong></div><div><small>Est. 1RM</small><strong><%= log.estimatedOneRepMax ? Math.round(log.estimatedOneRepMax) : '—' %> <span>lbs</span></strong></div></div>
            </article>
            <% }) %>
            <div id="activity-empty" class="empty-state" <%= activityLogs.length ? 'hidden' : '' %>><%- include('partials/icon',{name:'activity'}) %><h2><%= activityLogs.length ? 'No matching activities' : 'Your story starts here.' %></h2><p><%= activityLogs.length ? 'Try another lift name, date, or filter.' : 'Your completed workouts and personal records will appear here.' %></p></div>
        </div>
        <div id="profile-subtab-gallery" role="tabpanel" aria-labelledby="profile-subtab-btn-gallery" style="display:none">
            <% const photos = myPosts.filter(p => p.imageUrl); %>
            <% if(photos.length) { %><div class="photo-grid"><% photos.forEach(p => { %><button data-src="<%= p.imageUrl %>" onclick="openLightbox(this.dataset.src)" aria-label="Open workout photo"><img src="<%= p.imageUrl %>" alt="<%= p.content || 'Workout photo' %>" loading="lazy"></button><% }) %></div><% } else { %><div class="empty-state"><%- include('partials/icon',{name:'photo'}) %><h2>Keep the good moments.</h2><p>Photos from your posts will appear here. Share a gym session or a hard-earned milestone.</p><button class="primary-action" onclick="openComposer()">Share a photo</button></div><% } %>
        </div>
    </section>

    <section class="tab-content" id="tab-social">
        <div class="section-line"><h1 style="font-size:28px">Your training circle</h1><button class="round-action" onclick="shareProfile()" aria-label="Invite a friend"><%- include('partials/icon',{name:'plus'}) %></button></div>
        <label class="search-field"><%- include('partials/icon',{name:'search'}) %><input type="search" placeholder="Search your friends" aria-label="Search your friends" oninput="filterFriends(this.value)"></label>
        <p id="friends-no-results" class="muted" hidden>No friends match your search.</p>

        <div class="social-friends-panel">
            <% if (pendingRequests.length > 0) { %>
                <div>
                    <div class="section-heading">Friend requests</div>
                    <% pendingRequests.forEach(req => { %>
                        <div class="request-card">
                            <% if (req.requesterPicture) { %>
                                <img src="<%= req.requesterPicture %>" class="post-avatar" alt=""/>
                            <% } else { %>
                                <div class="post-avatar-placeholder"><%= req.requesterName.charAt(0).toUpperCase() %></div>
                            <% } %>
                            <div class="request-info">
                                <div class="request-name"><%= req.requesterName %></div>
                                <div class="request-email"><%= req.requesterEmail %></div>
                            </div>
                            <div class="request-actions">
                                <form action="/social/friends/accept/<%= req.friendshipId %>" method="post" style="margin:0;">
                                    <button type="submit" class="btn-accept">Accept</button>
                                </form>
                                <form action="/social/friends/reject/<%= req.friendshipId %>" method="post" style="margin:0;">
                                    <button type="submit" class="btn-decline">Decline</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <div>
                <div class="section-heading">Add a friend</div>
                <div style="font-size:0.82rem;color:#555;margin-bottom:0.5rem;">Share this link — anyone who opens it gets added instantly.</div>
                <div style="display:flex;gap:0.5rem;align-items:center;">
                    <input type="text" id="inviteLinkInput" value="<%= inviteLink %>" readonly
                           style="flex:1;background:#111;border:1px solid #2a2a2a;border-radius:8px;
                                  color:#888;font-size:0.78rem;padding:0.55rem 0.75rem;outline:none;"/>
                    <button onclick="copyInviteLink()" id="copyBtn"
                            style="background:#1a2a1a;color:#4ade80;border:none;border-radius:8px;
                                   padding:0.55rem 0.9rem;font-size:0.8rem;font-weight:700;cursor:pointer;white-space:nowrap;">
                        Copy
                    </button>
                    <form action="/social/invite/reset" method="post" style="margin:0;"
                          onsubmit="return confirm('Generate a new invite link? The old one will stop working.')">
                        <button type="submit"
                                style="background:none;border:1px solid #2a2a2a;border-radius:8px;
                                       color:#555;padding:0.55rem 0.7rem;font-size:0.8rem;cursor:pointer;white-space:nowrap;">
                            Reset
                        </button>
                    </form>
                </div>
            </div>

            <% if (friends.length > 0) { %>
            <div>
                <div class="section-heading">Friends (<%= friends.length %>)</div>
                <% friends.forEach(f => { %>
                <div class="request-card friend-result" data-name="<%= f.name.toLowerCase() %>" role="link" tabindex="0" data-href="/user/<%= encodeURIComponent(f.userId) %>" style="cursor:pointer;" onclick="location.href=this.dataset.href" onkeydown="if(event.key==='Enter') location.href=this.dataset.href">
                    <% if (f.pictureUrl) { %>
                        <img src="<%= f.pictureUrl %>" class="post-avatar" alt=""/>
                    <% } else { %>
                        <div class="post-avatar-placeholder"><%= f.name.charAt(0).toUpperCase() %></div>
                    <% } %>
                    <div class="request-info">
                        <div class="request-name"><%= f.name %></div>
                    </div>
                    <form action="/social/friends/remove/<%= f.friendshipId %>" method="post" style="margin:0;"
                          onclick="event.stopPropagation()">
                        <button type="submit" class="btn-decline"
                                onclick="return confirm('Remove <%= f.name %> as a friend?')">Remove</button>
                    </form>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="empty-feed">
                <div>No friends yet.</div>
                <div style="color:#333;margin-top:0.25rem;">Share your invite link to get started.</div>
            </div>
            <% } %>
        </div>
    </section>

    <section class="tab-content" id="tab-cals">
        <div style="font-size:1.75rem;font-weight:800;letter-spacing:-0.5px;">Nutrition</div>

        <!-- sub-tab switcher -->
        <div style="display:flex;gap:0.4rem;background:#111;border-radius:12px;padding:0.3rem;">
            <button id="cals-tab-today" onclick="switchCalsTab('today')"
                    style="flex:1;padding:0.45rem 0;border:none;border-radius:9px;font-size:0.82rem;
                           font-weight:700;cursor:pointer;background:#1e1e1e;color:#fff;transition:background 0.15s;">
                Today
            </button>
            <button id="cals-tab-history" onclick="switchCalsTab('history')"
                    style="flex:1;padding:0.45rem 0;border:none;border-radius:9px;font-size:0.82rem;
                           font-weight:700;cursor:pointer;background:transparent;color:#555;transition:background 0.15s;">
                History
            </button>
        </div>

        <div id="cals-today">

        <% if (calsError) { %>
        <div id="cals-error-banner"
             style="background:#2a1a1a;border:1px solid #5a2a2a;border-radius:12px;
                    padding:0.8rem 1rem;display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
            <div style="display:flex;align-items:center;gap:0.6rem;">
                <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:#f87171;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;">
                    <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/>
                </svg>
                <span style="font-size:0.85rem;color:#f87171;">AI analysis failed — try again or use manual entry.</span>
            </div>
            <button onclick="document.getElementById('cals-error-banner').remove()"
                    style="background:none;border:none;color:#f87171;font-size:1.1rem;cursor:pointer;padding:0;line-height:1;">✕</button>
        </div>
        <% } %>

        <div class="nutrition-summary">
            <span class="sport-chip"><%- include('partials/icon',{name:'activity'}) %> Daily nutrition</span>
            <h2>Fuel your progress.</h2>
            <div class="activity-stats"><div><small>Calories</small><strong><%= calTotal.toLocaleString('en-US') %> <span>kcal</span></strong></div><div><small>Protein</small><strong><%= proteinTotal %> <span>g</span></strong></div><div><small>Carbs</small><strong><%= carbsTotal %> <span>g</span></strong></div></div>
        </div>
        <div class="section-line" style="margin:24px 0 12px"><h2>Log a meal</h2><span class="eyebrow">Photo or text</span></div>
        <p class="muted" style="font-size:13px;line-height:1.6;margin-bottom:16px">Add a photo or describe your meal for an estimate. Enter calories to log them directly.</p>
        <div class="post-composer">
            <form id="calsComposerForm" action="/cals/log" method="post" enctype="multipart/form-data"
                  onsubmit="document.getElementById('cals-loader').style.display='flex'">
                <input type="file" name="image" id="calsImageInput" style="display:none;"
                       accept="image/jpeg,image/png,image/webp"/>
                <div id="calsImagePreview" style="display:none;margin-bottom:0.4rem;">
                    <img id="calsPreviewImg" src="" alt=""
                         style="width:100%;max-height:180px;object-fit:cover;border-radius:8px;"/>
                    <button type="button" onclick="clearCalsImage()"
                            style="background:none;border:none;color:#e05252;font-size:0.75rem;
                                   cursor:pointer;margin-top:0.2rem;">Remove image</button>
                </div>
                <div class="composer-row">
                    <label style="cursor:pointer;flex-shrink:0;display:flex;align-items:center;">
                        <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:#555;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                            <path d="M21 15l-5-5L5 21"/>
                        </svg>
                        <input type="file" id="calsGalleryInput" accept="image/jpeg,image/png,image/webp"
                               style="display:none;" onchange="calsPickImage(this)"/>
                    </label>
                    <label style="cursor:pointer;flex-shrink:0;display:flex;align-items:center;">
                        <svg viewBox="0 0 24 24" style="width:20px;height:20px;stroke:#555;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                            <circle cx="12" cy="13" r="4"/>
                        </svg>
                        <input type="file" id="calsCameraInput" accept="image/*" capture="environment"
                               style="display:none;" onchange="calsPickImage(this)"/>
                    </label>
                    <textarea name="context" id="calsTextarea" aria-label="Meal description" placeholder="What did you eat?"
                              maxlength="500" rows="1" oninput="updateCalsButton()"></textarea>
                    <input type="number" name="calories" id="calsCalInput" aria-label="Calories (optional)" placeholder="kcal"
                           min="1" max="9999" oninput="updateCalsButton()" class="cal-num-input"/>
                    <button type="submit" id="calsSubmitBtn" disabled class="btn-log">Estimate</button>
                </div>
            </form>
        </div>

        <% if (calEntries.length > 0) { %>
        <div style="display:flex;align-items:baseline;justify-content:space-between;">
            <div class="section-heading" style="margin:0;">Today's log</div>
            <div style="font-size:0.8rem;color:#4ade80;font-weight:700;"><%= calTotal %> kcal total</div>
        </div>
        <div style="background:#1a1a1a;border-radius:12px;overflow:hidden;">
        <% calEntries.forEach((entry, i) => { %>
            <% const breakdown = entry.breakdown ? JSON.parse(entry.breakdown) : null; %>
            <% if (i > 0) { %>
            <div style="height:1px;background:#222;margin:0 0.85rem;"></div>
            <% } %>
            <!-- summary row -->
            <div onclick="toggleCalEntry(<%= entry.id %>)"
                 style="padding:0.75rem 0.85rem;display:flex;align-items:center;gap:0.65rem;cursor:pointer;">
                <% if (entry.imageUrl) { %>
                <button onclick="event.stopPropagation();openLightbox('<%= entry.imageUrl %>')"
                        style="background:#222;border:1px solid #333;border-radius:8px;
                               padding:0.4rem;cursor:pointer;display:flex;align-items:center;
                               justify-content:center;flex-shrink:0;">
                    <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#777;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                </button>
                <% } %>
                <div style="flex:1;min-width:0;">
                    <div style="font-size:0.72rem;color:#555;">
                        <%= entry.createdAt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) %>
                    </div>
                    <div style="font-size:0.9rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        <%= entry.description %>
                    </div>
                    <div style="font-size:0.78rem;margin-top:0.1rem;display:flex;gap:0.6rem;flex-wrap:wrap;">
                        <span><span style="color:#4ade80;font-weight:700;"><%= entry.calories %></span> <span style="color:#555;">kcal</span></span>
                        <% if (entry.proteinG) { %><span><span style="color:#fc4c02;font-weight:700;"><%= entry.proteinG %>g</span> <span style="color:#555;">protein</span></span><% } %>
                        <% if (entry.carbsG) { %><span><span style="color:#f59e0b;font-weight:700;"><%= entry.carbsG %>g</span> <span style="color:#555;">carbs</span></span><% } %>
                    </div>
                </div>
                <svg id="cal-chevron-<%= entry.id %>" viewBox="0 0 24 24"
                     style="width:14px;height:14px;stroke:#444;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;transition:transform 0.2s;">
                    <path d="M6 9l6 6 6-6"/>
                </svg>
            </div>

            <!-- expanded detail + edit -->
            <div id="cal-detail-<%= entry.id %>" style="display:none;padding:0 0.85rem 0.85rem;">
                <% if (breakdown && breakdown.length > 0) { %>
                <div style="background:#111;border-radius:8px;padding:0.6rem 0.75rem;margin-bottom:0.6rem;">
                    <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#444;margin-bottom:0.4rem;">Breakdown</div>
                    <% breakdown.forEach(item => { %>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:0.25rem 0;border-bottom:1px solid #1a1a1a;">
                        <span style="font-size:0.82rem;color:#ccc;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding-right:0.5rem;"><%= item.item %></span>
                        <div style="display:flex;gap:0.6rem;font-size:0.75rem;flex-shrink:0;">
                            <span style="color:#4ade80;"><%= item.calories %> kcal</span>
                            <% if (item.proteinG != null) { %><span style="color:#fc4c02;"><%= item.proteinG %>g P</span><% } %>
                            <% if (item.carbsG != null) { %><span style="color:#f59e0b;"><%= item.carbsG %>g C</span><% } %>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
                <div style="background:#111;border-radius:8px;padding:0.6rem 0.75rem;">
                    <div style="font-size:0.68rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#444;margin-bottom:0.5rem;">Edit</div>
                    <input type="text" id="cal-desc-<%= entry.id %>" value="<%= entry.description %>"
                           style="width:100%;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;
                                  color:#fff;font-size:0.85rem;padding:0.4rem 0.6rem;outline:none;margin-bottom:0.5rem;box-sizing:border-box;"/>
                    <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem;">
                        <div style="flex:1;">
                            <div style="font-size:0.68rem;color:#555;margin-bottom:0.2rem;">kcal</div>
                            <input type="number" id="cal-kcal-<%= entry.id %>" value="<%= entry.calories %>"
                                   style="width:100%;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;
                                          color:#4ade80;font-size:0.85rem;padding:0.4rem 0.5rem;outline:none;"/>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:0.68rem;color:#555;margin-bottom:0.2rem;">protein (g)</div>
                            <input type="number" id="cal-protein-<%= entry.id %>" value="<%= entry.proteinG ?? '' %>"
                                   style="width:100%;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;
                                          color:#fc4c02;font-size:0.85rem;padding:0.4rem 0.5rem;outline:none;"/>
                        </div>
                        <div style="flex:1;">
                            <div style="font-size:0.68rem;color:#555;margin-bottom:0.2rem;">carbs (g)</div>
                            <input type="number" id="cal-carbs-<%= entry.id %>" value="<%= entry.carbsG ?? '' %>"
                                   style="width:100%;background:#1a1a1a;border:1px solid #2a2a2a;border-radius:6px;
                                          color:#f59e0b;font-size:0.85rem;padding:0.4rem 0.5rem;outline:none;"/>
                        </div>
                    </div>
                    <div style="display:flex;gap:0.5rem;">
                        <button onclick="saveCalEntry(<%= entry.id %>)"
                                style="flex:1;background:#1a2a1a;border:1px solid #2a4a2a;border-radius:8px;
                                       color:#4ade80;font-size:0.82rem;font-weight:700;padding:0.5rem;cursor:pointer;">
                            Save
                        </button>
                        <form action="/cals/delete/<%= entry.id %>" method="post" style="margin:0;flex:1;" onclick="event.stopPropagation()">
                            <button type="submit" onclick="return confirm('Delete this entry?')"
                                    style="width:100%;background:#2a1a1a;border:1px solid #3a2a2a;border-radius:8px;
                                           color:#f87171;font-size:0.82rem;font-weight:600;padding:0.5rem;cursor:pointer;">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
        </div>
        <% } %>

        <% if(!calEntries.length) { %><div class="nutrition-empty"><%- include('partials/icon',{name:'more'}) %><div><strong>Your daily food journal</strong><p>Meals you log today will appear here.</p></div></div><% } %>
        </div><!-- /#cals-today -->

        <!-- History sub-tab -->
        <div id="cals-history" style="display:none;">
            <% if (calHistoryDays.length === 0) { %>
            <div style="text-align:center;color:#444;font-size:0.9rem;padding:3rem 0;">
                No history yet. Start logging to see past days here.
            </div>
            <% } else { %>
            <% calHistoryDays.forEach(day => { %>
            <div style="background:#1a1a1a;border-radius:12px;overflow:hidden;margin-bottom:0.5rem;">
                <!-- day header -->
                <div onclick="toggleHistoryDay('<%= day.date %>')"
                     style="padding:0.85rem;display:flex;align-items:center;gap:0.65rem;cursor:pointer;">
                    <div style="flex:1;min-width:0;">
                        <div style="font-size:0.88rem;font-weight:700;"><%= day.displayDate %></div>
                        <div style="font-size:0.78rem;margin-top:0.15rem;display:flex;gap:0.6rem;flex-wrap:wrap;">
                            <span><span style="color:#4ade80;font-weight:700;"><%= day.total %></span> <span style="color:#555;">kcal</span></span>
                            <% if (day.proteinTotal > 0) { %><span><span style="color:#fc4c02;font-weight:700;"><%= day.proteinTotal %>g</span> <span style="color:#555;">protein</span></span><% } %>
                            <% if (day.carbsTotal > 0) { %><span><span style="color:#f59e0b;font-weight:700;"><%= day.carbsTotal %>g</span> <span style="color:#555;">carbs</span></span><% } %>
                        </div>
                    </div>
                    <svg id="hist-chevron-<%= day.date %>" viewBox="0 0 24 24"
                         style="width:14px;height:14px;stroke:#444;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;transition:transform 0.2s;">
                        <path d="M6 9l6 6 6-6"/>
                    </svg>
                </div>
                <!-- individual entries -->
                <div id="hist-day-<%= day.date %>" style="display:none;">
                    <% day.entries.forEach((entry, i) => { %>
                    <div style="border-top:1px solid #222;padding:0.6rem 0.85rem;display:flex;align-items:center;gap:0.65rem;">
                        <% if (entry.imageUrl) { %>
                        <button onclick="event.stopPropagation();openLightbox('<%= entry.imageUrl %>')"
                                style="background:#222;border:1px solid #333;border-radius:8px;
                                       padding:0.4rem;cursor:pointer;display:flex;align-items:center;
                                       justify-content:center;flex-shrink:0;">
                            <svg viewBox="0 0 24 24" style="width:16px;height:16px;stroke:#777;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                <circle cx="12" cy="13" r="4"/>
                            </svg>
                        </button>
                        <% } %>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:0.7rem;color:#555;">
                                <%= entry.createdAt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) %>
                            </div>
                            <div style="font-size:0.88rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                <%= entry.description %>
                            </div>
                            <div style="font-size:0.75rem;margin-top:0.1rem;display:flex;gap:0.5rem;flex-wrap:wrap;">
                                <span><span style="color:#4ade80;font-weight:700;"><%= entry.calories %></span> <span style="color:#555;">kcal</span></span>
                                <% if (entry.proteinG) { %><span><span style="color:#fc4c02;font-weight:700;"><%= entry.proteinG %>g</span> <span style="color:#555;">protein</span></span><% } %>
                                <% if (entry.carbsG) { %><span><span style="color:#f59e0b;font-weight:700;"><%= entry.carbsG %>g</span> <span style="color:#555;">carbs</span></span><% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            </div>
            <% }) %>
            <% } %>
        </div><!-- /#cals-history -->

    </section>

    <%- include('partials/bottom-nav', { mode: 'tabs', current: 'home', workoutHref: activeSessionId ? '/group/' + activeSessionId : null }) %>

    <script>
        let dashboardChartsInitialized = false;

        let currentProfileTab = 'dashboard';
        function switchProfileSubTab(name) {
            if(!['overview','dashboard','activities','gallery'].includes(name)) name = 'dashboard';
            currentProfileTab = name;
            ['overview','dashboard','activities','gallery'].forEach(id => {
                document.getElementById('profile-subtab-' + id).style.display = id === name ? (id === 'dashboard' ? 'flex' : 'block') : 'none';
                const button = document.getElementById('profile-subtab-btn-' + id);
                button.classList.toggle('active',id === name);
                button.setAttribute('aria-selected',String(id === name));
            });
            if (name === 'dashboard' && !dashboardChartsInitialized && typeof Chart !== 'undefined') {
                dashboardChartsInitialized = true;
                initDashboardCharts();
            }
            history.replaceState(null,'',location.pathname + location.search + '#tab-profile-' + name);
        }

        async function copyInviteLink() {
            const input = document.getElementById('inviteLinkInput');
            try {
                await navigator.clipboard.writeText(input.value);
                const btn = document.getElementById('copyBtn');
                btn.textContent = 'Copied!';
                setTimeout(() => btn.textContent = 'Copy',2000);
            } catch { input.select(); showToast('Select and copy your invite link.'); }
        }

        async function musicApi(path, options = {}) {
            const response = await fetch(path, { headers:{'Content-Type':'application/json'}, ...options });
            if (!response.ok) throw new Error((await response.json()).error || 'Music request failed');
            return response.status === 204 ? null : (await response.json()).data;
        }
        async function connectAppleMusic() {
            try {
                const { developerToken } = await musicApi('/api/music/apple/developer-token');
                await MusicKit.configure({ developerToken, app:{ name:'Workout', build:'1.1.0' } });
                const music = MusicKit.getInstance();
                const musicUserToken = await music.authorize();
                await musicApi('/api/music/apple/connect', { method:'POST', body:JSON.stringify({ musicUserToken }) });
                location.reload();
            } catch (error) { alert(error.message || 'Could not connect Apple Music'); }
        }
        async function syncMusic(provider) {
            try { await musicApi(`/api/music/${provider}/sync`, { method:'POST' }); location.reload(); }
            catch (error) { alert(error.message || 'Could not sync playlists'); }
        }
        async function selectPlaylist(id) {
            try { await musicApi(`/api/music/playlists/${id}/select`, { method:'PUT' }); location.reload(); }
            catch (error) { alert(error.message || 'Could not select playlist'); }
        }
        async function publishPlaylist(id, isPublished, button) {
            try {
                await musicApi(`/api/music/playlists/${id}/publish`, { method:'PUT', body:JSON.stringify({ isPublished }) });
                button.textContent = isPublished ? 'Public' : 'Private';
                button.classList.toggle('active', isPublished);
                button.setAttribute('onclick', `publishPlaylist(${id}, ${!isPublished}, this)`);
            } catch (error) { alert(error.message || 'Could not update playlist'); }
        }

        function switchTab(name, btn) {
            if(!document.getElementById('tab-' + name)) return;
            document.querySelectorAll('.tab-content').forEach(el => el.classList.toggle('active',el.id === 'tab-' + name));
            document.querySelectorAll('.app-nav [data-tab]').forEach(el => {
                const active = el.dataset.tab === name;
                el.classList.toggle('active',active);
                if(active) el.setAttribute('aria-current','page'); else el.removeAttribute('aria-current');
            });
            history.replaceState(null,'',location.pathname + location.search + '#tab-' + name);
            if(name === 'profile') switchProfileSubTab(currentProfileTab);
        }

        const ACTIVE_SESSION_ID = <%- JSON.stringify(activeSessionId) %>;
        const initialHash = window.location.hash;
        function restoreTab(hash) {
            const tab = hash.replace('#tab-','');
            if(tab === 'workouts' && ACTIVE_SESSION_ID) location.replace('/group/' + ACTIVE_SESSION_ID);
            else if(['home','profile','social','workouts','cals'].includes(tab)) switchTab(tab);
            else if(hash === '#social-friends') switchTab('social');
            else if(tab.startsWith('profile-')) {
                switchTab('profile');
                switchProfileSubTab(tab.replace('profile-',''));
                if(tab === 'profile-calendar') history.replaceState(null,'',location.pathname + location.search + hash);
            }
        }
        restoreTab(initialHash);
        window.addEventListener('hashchange',() => {
            const hash = location.hash;
            restoreTab(hash);
            if(hash === '#tab-profile-calendar') openCalendar();
        });

        // Spotify connect redirects back here — the music card now lives in
        // Settings, so reopen it to show the connected/error state. Inlined
        // rather than calling openSettings(): that's declared in a later
        // <script> block that hasn't run yet at this point in page load.
        if (/^music=spotify-/.test(location.search.slice(1))) {
            window.addEventListener('DOMContentLoaded',() => openSettings());
            history.replaceState(null, '', location.pathname + location.hash);
        }

        // Deferred until Dashboard is first opened — see switchProfileSubTab.
        function initDashboardCharts() {
            const LT_LINE = '#2A2A2A';
            const LT_MUTED = '#8A8A8E';
            const LT_TOOLTIP_BG = '#2A2A2A';
            const rawDatasets = <%- JSON.stringify(chartDatasets) %>;

            if (rawDatasets.length > 0) {
                const ctx = document.getElementById('progressChart').getContext('2d');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        datasets: rawDatasets.map(ds => ({
                            label: ds.label,
                            data: ds.points.map(p => ({ x: new Date(p.x).getTime(), y: p.y })),
                            borderColor: ds.color,
                            backgroundColor: ds.color + '22',
                            borderWidth: 2.5,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: ds.color,
                            tension: 0.35,
                            fill: false,
                        }))
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'nearest', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: LT_TOOLTIP_BG,
                                titleColor: '#9CA3AF',
                                bodyColor: '#fff',
                                borderWidth: 0,
                                padding: 10,
                                callbacks: {
                                    title: items => {
                                        const d = new Date(items[0].parsed.x);
                                        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                                    },
                                    label: item => ` ${item.dataset.label}: ${item.parsed.y} lbs`
                                }
                            }
                        },
                        scales: {
                            x: {
                                type: 'linear',
                                grid: { color: LT_LINE },
                                ticks: {
                                    color: LT_MUTED,
                                    maxTicksLimit: 5,
                                    callback: val => new Date(val).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
                                },
                                border: { color: LT_LINE }
                            },
                            y: {
                                grid: { color: LT_LINE },
                                ticks: { color: LT_MUTED, stepSize: 1 },
                                border: { color: LT_LINE },
                                title: { display: true, text: 'Training Max (lbs)', color: LT_MUTED, font: { size: 11 } }
                            }
                        }
                    }
                });

                const legend = document.getElementById('chartLegend');
                rawDatasets.forEach(ds => {
                    const item = document.createElement('div');
                    item.className = 'legend-item';
                    item.innerHTML = `<span class="legend-dot" style="background:${ds.color}"></span>${ds.label}`;
                    legend.appendChild(item);
                });
            }

            const calData = <%- JSON.stringify(calChartData) %>;
            const weightData = <%- JSON.stringify(weightChartData) %>;

            if (weightData.length > 0) {
                const wCtx = document.getElementById('weightChart').getContext('2d');
                new Chart(wCtx, {
                    type: 'line',
                    data: {
                        labels: weightData.map(d => d.date),
                        datasets: [{
                            data: weightData.map(d => d.weight),
                            borderColor: '#a78bfa',
                            backgroundColor: '#a78bfa18',
                            borderWidth: 2,
                            pointRadius: weightData.length < 15 ? 4 : 2,
                            pointBackgroundColor: '#a78bfa',
                            tension: 0.3,
                            fill: true,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: LT_TOOLTIP_BG,
                                titleColor: '#9CA3AF',
                                bodyColor: '#fff',
                                borderWidth: 0,
                                padding: 10,
                                callbacks: {
                                    title: items => {
                                        const d = new Date(items[0].label + 'T12:00:00');
                                        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                                    },
                                    label: item => ` ${item.parsed.y} lbs`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: LT_LINE },
                                ticks: {
                                    color: LT_MUTED,
                                    maxTicksLimit: 6,
                                    callback: (_, i) => {
                                        const d = new Date(weightData[i].date + 'T12:00:00');
                                        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                                    }
                                },
                                border: { color: LT_LINE }
                            },
                            y: {
                                grid: { color: LT_LINE },
                                ticks: { color: LT_MUTED },
                                border: { color: LT_LINE },
                                title: { display: true, text: 'lbs', color: LT_MUTED, font: { size: 11 } }
                            }
                        }
                    }
                });
            }

            if (calData.length > 0) {
                const calCtx = document.getElementById('calChart').getContext('2d');
                new Chart(calCtx, {
                    type: 'bar',
                    data: {
                        labels: calData.map(d => d.date),
                        datasets: [{
                            data: calData.map(d => d.total),
                            backgroundColor: '#4ade8044',
                            borderColor: '#4ade80',
                            borderWidth: 2,
                            borderRadius: 4,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: LT_TOOLTIP_BG,
                                titleColor: '#9CA3AF',
                                bodyColor: '#fff',
                                borderWidth: 0,
                                padding: 10,
                                callbacks: {
                                    title: items => {
                                        const d = new Date(items[0].label + 'T12:00:00');
                                        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                                    },
                                    label: item => ` ${item.parsed.y} kcal`
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: LT_LINE },
                                ticks: {
                                    color: LT_MUTED,
                                    maxTicksLimit: 6,
                                    callback: (_, i) => {
                                        const d = new Date(calData[i].date + 'T12:00:00');
                                        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                                    }
                                },
                                border: { color: LT_LINE }
                            },
                            y: {
                                grid: { color: LT_LINE },
                                ticks: { color: LT_MUTED },
                                border: { color: LT_LINE },
                                title: { display: true, text: 'kcal', color: LT_MUTED, font: { size: 11 } }
                            }
                        }
                    }
                });
            }
        }

        function previewImage(input) {
            if (!input.files || !input.files[0]) return;
            const file = input.files[0];
            const MAX_W = 1200;
            const QUALITY = 0.82;
            const img = new Image();
            const url = URL.createObjectURL(file);
            img.onload = function() {
                URL.revokeObjectURL(url);
                const scale = Math.min(1, MAX_W / img.width);
                const canvas = document.createElement('canvas');
                canvas.width = Math.round(img.width * scale);
                canvas.height = Math.round(img.height * scale);
                canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
                canvas.toBlob(blob => {
                    const compressed = new File([blob], 'photo.jpg', { type: 'image/jpeg' });
                    const dt = new DataTransfer();
                    dt.items.add(compressed);
                    document.getElementById('actualImageInput').files = dt.files;
                    document.getElementById('previewImg').src = canvas.toDataURL('image/jpeg', QUALITY);
                    document.getElementById('imagePreview').style.display = 'block';
                }, 'image/jpeg', QUALITY);
            };
            img.src = url;
        }

        function clearImage() {
            document.getElementById('imageInput').value = '';
            document.getElementById('cameraInput').value = '';
            document.getElementById('actualImageInput').value = '';
            document.getElementById('imagePreview').style.display = 'none';
            document.getElementById('previewImg').src = '';
        }

        function calsPickImage(input) {
            const file = input.files && input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('calsPreviewImg').src = e.target.result;
                document.getElementById('calsImagePreview').style.display = 'block';
            };
            reader.readAsDataURL(file);
            const dt = new DataTransfer();
            dt.items.add(file);
            document.getElementById('calsImageInput').files = dt.files;
            updateCalsButton();
        }

        function clearCalsImage() {
            document.getElementById('calsPreviewImg').src = '';
            document.getElementById('calsImagePreview').style.display = 'none';
            document.getElementById('calsImageInput').value = '';
            document.getElementById('calsGalleryInput').value = '';
            document.getElementById('calsCameraInput').value = '';
            updateCalsButton();
        }

        function toggleCalEntry(id) {
            const detail = document.getElementById('cal-detail-' + id);
            const chevron = document.getElementById('cal-chevron-' + id);
            const open = detail.style.display === 'none';
            detail.style.display = open ? 'block' : 'none';
            chevron.style.transform = open ? 'rotate(180deg)' : '';
        }

        async function saveCalEntry(id) {
            const description = document.getElementById('cal-desc-' + id).value.trim();
            const calories = document.getElementById('cal-kcal-' + id).value;
            const proteinG = document.getElementById('cal-protein-' + id).value;
            const carbsG = document.getElementById('cal-carbs-' + id).value;
            const btn = event.currentTarget;
            try {
                const res = await fetch('/cals/update/' + id, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description, calories, proteinG, carbsG }),
                });
                if (res.ok) {
                    btn.textContent = 'Saved!';
                    btn.style.color = '#4ade80';
                    setTimeout(() => { btn.textContent = 'Save'; btn.style.color = ''; }, 1500);
                }
            } catch(e) {
                btn.textContent = 'Error';
                setTimeout(() => { btn.textContent = 'Save'; }, 1500);
            }
        }

        function updateCalsButton() {
            const hasText = document.getElementById('calsTextarea').value.trim().length > 0;
            const hasImage = !!(document.getElementById('calsImageInput').files &&
                                document.getElementById('calsImageInput').files.length > 0);
            const calsVal = parseInt(document.getElementById('calsCalInput').value);
            const hasCals = !isNaN(calsVal) && calsVal > 0;
            const hasContent = hasText || hasImage;
            const btn = document.getElementById('calsSubmitBtn');
            if (hasCals) {
                btn.disabled = false;
                btn.textContent = 'Log';
            } else {
                btn.disabled = !hasContent;
                btn.textContent = 'Estimate';
            }
        }

        document.body.addEventListener('htmx:afterSwap', function(e) {
            const id = e.detail.target && e.detail.target.id;
            if (id && id.startsWith('lift-card-')) {
                const newEl = document.getElementById(id);
                if (!newEl) return;
                const badge = document.createElement('span');
                badge.textContent = 'Updated';
                badge.style.cssText = 'color:#4ade80;font-size:0.75rem;font-weight:600;margin-left:0.5rem;';
                const nameEl = newEl.querySelector('span');
                nameEl.after(badge);
                setTimeout(() => badge.remove(), 1500);
            }
        });

        function openLightbox(src) {
            const lb = document.getElementById('lightbox');
            document.getElementById('lightboxImg').src = src;
            lb.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightbox').style.display = 'none';
            document.body.style.overflow = '';
        }

        function switchCalsTab(tab) {
            const isToday = tab === 'today';
            document.getElementById('cals-today').style.display = isToday ? 'block' : 'none';
            document.getElementById('cals-history').style.display = isToday ? 'none' : 'block';
            document.getElementById('cals-tab-today').style.background = isToday ? '#1e1e1e' : 'transparent';
            document.getElementById('cals-tab-today').style.color = isToday ? '#fff' : '#555';
            document.getElementById('cals-tab-history').style.background = isToday ? 'transparent' : '#1e1e1e';
            document.getElementById('cals-tab-history').style.color = isToday ? '#555' : '#fff';
        }

        function toggleCalDay(iso) {
            const det = document.getElementById('cal-detail-' + iso);
            const btn = document.getElementById('cal-day-' + iso);
            const wasOpen = det.style.display !== 'none';
            document.querySelectorAll('.cal-detail').forEach(e => e.style.display = 'none');
            document.querySelectorAll('.cal-day.selected').forEach(e => e.classList.remove('selected'));
            if (!wasOpen) {
                det.style.display = 'block';
                btn.classList.add('selected');
                det.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function toggleHistoryDay(date) {
            const detail = document.getElementById('hist-day-' + date);
            const chevron = document.getElementById('hist-chevron-' + date);
            const open = detail.style.display === 'none';
            detail.style.display = open ? 'block' : 'none';
            chevron.style.transform = open ? 'rotate(180deg)' : '';
        }

        function toggleHostTM(liftId) {
            const form = document.getElementById(`host-tm-${liftId}`);
            const isHidden = form.style.display === 'none';
            // Collapse all others first
            document.querySelectorAll('[id^="host-tm-"]').forEach(f => f.style.display = 'none');
            form.style.display = isHidden ? 'block' : 'none';
            if (isHidden) form.querySelector('input[type="number"]').focus();
        }
    </script>

    <style>@keyframes spin { to { transform: rotate(360deg); } }</style>

    <div id="cals-loader"
         style="display:none;position:fixed;inset:0;background:#0f0f0f;z-index:9998;
                flex-direction:column;align-items:center;justify-content:center;gap:1rem;">
        <div style="width:36px;height:36px;border:3px solid #2a2a2a;border-top-color:#4ade80;
                    border-radius:50%;animation:spin 0.8s linear infinite;"></div>
        <div style="color:#555;font-size:0.85rem;">Analyzing your meal…</div>
    </div>

    <div id="lightbox" onclick="closeLightbox()"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.92);z-index:9999;
                align-items:center;justify-content:center;cursor:zoom-out;">
        <img id="lightboxImg" src="" alt=""
             style="max-width:95vw;max-height:95vh;object-fit:contain;border-radius:6px;"/>
    </div>

    <!-- Settings page (My lifts) -->
    <div id="settings-page" class="settings-page">
        <div class="settings-page-header">
            <button type="button" class="icon-btn" onclick="closeSettings()" aria-label="Back"
                    style="color:#fc4c02;padding:0;">
                <svg viewBox="0 0 24 24" style="width:20px;height:20px;"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div style="font-size:0.95rem;font-weight:700;">Settings</div>
        </div>
        <div class="settings-page-body">
            <div class="section-heading">Your profile</div>
            <form class="add-form" action="/profile/name" method="post">
                <input type="text" name="displayName" aria-label="Display name" value="<%= user.displayName %>" required maxlength="80">
                <button type="submit">Save</button>
            </form>
            <button class="more-link" onclick="openWeightModal()"><%- include('partials/icon',{name:'activity'}) %><span>Body weight & privacy<small>Log your weight and choose what friends can see</small></span><%- include('partials/icon',{name:'chevron'}) %></button>
            <div class="section-heading">My lifts</div>

            <div id="lifts-list">
            <% coreWorkouts.forEach(w => { %>
                <%- include('partials/lift-card', { w }) %>
            <% }) %>
            </div>

            <form class="add-form"
                  hx-post="/profile/lifts" hx-target="#lifts-list" hx-swap="beforeend"
                  hx-on::after-request="this.reset()">
                <input type="text" name="name" placeholder="Add a lift" required maxlength="60"/>
                <button type="submit">Add</button>
            </form>

            <% if (music.enabled) { %>
            <div class="section-heading">Workout music</div>
            <div class="card" id="music-settings-card">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                    <div style="font-size:0.82rem;color:#777;">Pick one playlist to start with your workout.</div>
                    <span style="font-size:1.2rem;">♫</span>
                </div>
                <div class="music-provider-row">
                    <% if (music.configured.spotify && !music.connected.includes('SPOTIFY')) { %>
                        <a href="/music/spotify/connect" class="music-btn spotify">Connect Spotify</a>
                    <% } else if (music.connected.includes('SPOTIFY')) { %>
                        <button class="music-btn spotify" onclick="syncMusic('spotify')">Spotify connected · Sync</button>
                    <% } %>
                    <% if (music.configured.appleMusic && !music.connected.includes('APPLE_MUSIC')) { %>
                        <button class="music-btn apple" onclick="connectAppleMusic()">Connect Apple Music</button>
                    <% } else if (music.connected.includes('APPLE_MUSIC')) { %>
                        <button class="music-btn apple" onclick="syncMusic('apple_music')">Apple Music connected · Sync</button>
                    <% } %>
                    <% if (!music.configured.spotify && !music.configured.appleMusic) { %>
                        <span style="font-size:0.78rem;color:#555;">Add provider credentials to enable connections.</span>
                    <% } %>
                </div>
                <% music.playlists.forEach(playlist => { %>
                <div class="playlist-row">
                    <% if (playlist.artworkUrl) { %><img class="playlist-art" src="<%= playlist.artworkUrl %>" alt=""/><% } else { %><div class="playlist-art" style="display:flex;align-items:center;justify-content:center;">♫</div><% } %>
                    <div style="min-width:0;">
                        <div class="playlist-title"><%= playlist.name %></div>
                        <div class="playlist-provider"><%= playlist.provider === 'SPOTIFY' ? 'Spotify' : 'Apple Music' %></div>
                    </div>
                    <div class="playlist-actions">
                        <button class="mini-btn <%= playlist.isSelected ? 'active' : '' %>" onclick="selectPlaylist(<%= playlist.id %>)"><%= playlist.isSelected ? 'Selected' : 'Use' %></button>
                        <button class="mini-btn <%= playlist.isPublished ? 'active' : '' %>" onclick="publishPlaylist(<%= playlist.id %>, <%= !playlist.isPublished %>, this)"><%= playlist.isPublished ? 'Public' : 'Private' %></button>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>

            <% if (isAdmin) { %>
            <a href="/admin"
               style="display:block;width:100%;padding:0.85rem;background:#1a1a2a;border:1px solid #2a2a4a;
                      color:#fc4c02;border-radius:12px;font-size:0.95rem;font-weight:600;cursor:pointer;
                      text-align:center;text-decoration:none;">
                Admin
            </a>
            <% } %>

            <form action="/logout" method="post">
                <button type="submit"
                        style="width:100%;padding:0.85rem;background:#1a1a1a;border:1px solid #2a2a2a;
                               color:#e05252;border-radius:12px;font-size:0.95rem;font-weight:600;cursor:pointer;">
                    Sign out
                </button>
            </form>

            <div style="text-align:center;font-size:0.72rem;color:#333;">v<%= appVersion %></div>
        </div>
    </div>

    <!-- Body weight modal -->
    <div id="weight-modal" class="modal-overlay" onclick="if (event.target === this) closeWeightModal()">
        <div class="modal-card">
            <div class="modal-header">
                <div class="modal-title">Body weight</div>
                <button type="button" class="modal-close" onclick="closeWeightModal()" aria-label="Close">✕</button>
            </div>

            <div id="weight-display-wrap">
            <% if (currentWeight) { %>
                <div class="card" style="display:flex;align-items:baseline;gap:0.4rem;">
                    <span style="font-size:1.75rem;font-weight:800;letter-spacing:-1px;"><%= currentWeight %></span>
                    <span style="font-size:0.85rem;color:#555;">lbs &nbsp;·&nbsp; last logged</span>
                </div>
            <% } %>
            </div>

            <form class="add-form"
                  hx-post="/profile/weight" hx-target="#weight-display-wrap" hx-swap="innerHTML"
                  hx-vals="js:{loggedOn: new Date().toLocaleDateString('en-CA')}"
                  hx-on::after-request="this.reset()">
                <input type="number" name="weightLbs" step="0.1" min="50" max="999" id="weight-input"
                       placeholder="<%= currentWeight ? 'Overwrites entry (lbs)' : 'Log your weight (lbs)' %>"
                       required/>
                <button type="submit">Log</button>
            </form>

            <form hx-post="/profile/privacy" hx-target="#privacy-status" hx-swap="outerHTML">
                <button type="submit"
                        style="width:100%;display:flex;align-items:center;justify-content:space-between;
                               padding:0.85rem 1rem;background:#1a1a1a;border:1px solid #2a2a2a;
                               border-radius:12px;color:#fff;font-size:0.9rem;cursor:pointer;">
                    <span>Show weight to friends</span>
                    <span id="privacy-status" style="font-size:0.75rem;font-weight:700;color:<%= hideWeight ? '#555' : '#fc4c02' %>;">
                        <%= hideWeight ? 'OFF' : 'ON' %>
                    </span>
                </button>
            </form>
        </div>
    </div>

    <script>
        function openSettings() {
            document.getElementById('settings-page').classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeSettings() {
            document.getElementById('settings-page').classList.remove('show');
            document.body.style.overflow = '';
        }
        function openWeightModal() {
            document.getElementById('weight-modal').classList.add('show');
            document.body.style.overflow = 'hidden';
            if (document.getElementById('weight-display-wrap').children.length > 0) {
                const today = new Date();
                document.getElementById('weight-input').placeholder =
                    `Overwrites ${today.getMonth() + 1}-${today.getDate()} entry (lbs)`;
            }
        }
        function closeWeightModal() {
            document.getElementById('weight-modal').classList.remove('show');
            document.body.style.overflow = '';
        }
    </script>

    <%- include('partials/home-dialogs') %>
</body>
</html>
