<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>WORKOUT</title>
    <%- include('partials/pwa-head') %>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0f0f0f;
            color: #fff;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .logo {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 0.5rem;
        }

        .tagline {
            color: #555;
            font-size: 0.9rem;
            margin-bottom: 3rem;
        }

        .google-btn {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #fff;
            color: #111;
            border: none;
            border-radius: 12px;
            padding: 0.85rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            width: 100%;
            max-width: 320px;
            justify-content: center;
        }

        .google-btn:hover {
            background: #f0f0f0;
        }

        .google-btn svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        .apple-btn {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #fff;
            color: #111;
            border: none;
            border-radius: 12px;
            padding: 0.85rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            width: 100%;
            max-width: 320px;
            justify-content: center;
            margin-top: 0.75rem;
        }

        .apple-btn:hover {
            background: #f0f0f0;
        }

        .apple-btn svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
        }
    </style>
    <%- include('partials/app-theme') %>
</head>
<body class="login-page">
    <div class="login-emblem"><%- include('partials/icon',{name:'lift'}) %></div>
    <div class="eyebrow">Your personal training journal</div>
    <h1 class="logo">Every rep.<br>More you<span>.</span></h1>
    <div class="tagline">Track your lifts. Find your rhythm.<br>Build something stronger.</div>

    <a class="google-btn" href="/auth/google">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Sign in with Google
    </a>

    <% if (typeof appleSigninEnabled !== 'undefined' && appleSigninEnabled) { %>
    <a class="apple-btn" href="/auth/apple">
        <svg viewBox="0 0 384 512" xmlns="http://www.w3.org/2000/svg">
            <path fill="#000" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
        </svg>
        Sign in with Apple
    </a>
    <% } %>
</body>
</html>
