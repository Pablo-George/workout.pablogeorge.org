<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= profile.displayName %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #0f0f0f;
            color: #fff;
            min-height: 100dvh;
            padding: 1.5rem 1rem 2rem;
            max-width: 600px;
            margin: 0 auto;
        }
        .card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 14px;
            padding: 1rem;
            margin-bottom: 0.75rem;
        }
        .section-heading {
            font-size: 0.72rem;
            font-weight: 700;
            color: #555;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin: 1.25rem 0 0.5rem;
        }
        .lift-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.75rem 1rem;
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            margin-bottom: 0.5rem;
        }
        .lift-name { font-size: 0.95rem; font-weight: 600; }
        .lift-meta { font-size: 0.8rem; color: #888; text-align: right; }
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            color: #fc4c02;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            margin-bottom: 1.25rem;
        }
        .avatar {
            width: 60px; height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }
        .avatar-placeholder {
            width: 60px; height: 60px;
            border-radius: 50%;
            background: #2a2a2a;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 1.4rem; color: #555;
        }
        .now-playing { display:flex;gap:0.8rem;align-items:center;border-color:#31543d;background:#131d16; }
        .music-art { width:54px;height:54px;border-radius:8px;object-fit:cover;background:#292929;flex-shrink:0; }
        .live { display:inline-flex;align-items:center;gap:0.35rem;color:#4ade80;font-size:0.67rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em; }
        .live::before { content:"";width:6px;height:6px;border-radius:50%;background:#4ade80;box-shadow:0 0 8px #4ade80; }
        .playlist { display:flex;align-items:center;gap:0.75rem;color:inherit;text-decoration:none; }
        .playlist-copy { min-width:0;flex:1; }
        .playlist-name { font-size:0.92rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
        .playlist-meta { color:#777;font-size:0.75rem;margin-top:3px; }
    </style>
    <%- include('partials/app-theme') %>
</head>
<body>

    <a href="javascript:history.back()" class="back-btn">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:#fc4c02;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;">
            <polyline points="15 18 9 12 15 6"/>
        </svg>
        Back
    </a>

    <div class="card" style="display:flex;align-items:center;gap:1rem;">
        <% if (profile.pictureUrl) { %>
            <img src="<%= profile.pictureUrl %>" class="avatar" alt="avatar"/>
        <% } else { %>
            <div class="avatar-placeholder"><%= profile.displayName.charAt(0).toUpperCase() %></div>
        <% } %>
        <div style="font-size:1.25rem;font-weight:800;"><%= profile.displayName %></div>
    </div>

    <% if (nowPlaying) { %>
        <div class="section-heading">Live workout</div>
        <a class="card now-playing" href="<%= nowPlaying.externalUrl || '#' %>" <%= nowPlaying.externalUrl ? 'target="_blank" rel="noopener"' : '' %>>
            <% if (nowPlaying.artworkUrl) { %><img class="music-art" src="<%= nowPlaying.artworkUrl %>" alt=""/><% } else { %><div class="music-art" style="display:flex;align-items:center;justify-content:center;">♫</div><% } %>
            <div style="min-width:0;">
                <div class="live">Working out · <%= nowPlaying.liftName %></div>
                <div class="playlist-name" style="margin-top:4px;"><%= nowPlaying.title %></div>
                <div class="playlist-meta"><%= nowPlaying.artist %> · <%= nowPlaying.provider === 'SPOTIFY' ? 'Spotify' : 'Apple Music' %></div>
            </div>
        </a>
    <% } %>

    <% if (publishedPlaylists.length > 0) { %>
        <div class="section-heading">Workout playlists</div>
        <% publishedPlaylists.forEach(playlist => { %>
            <a class="card playlist" href="<%= playlist.externalUrl || '#' %>" <%= playlist.externalUrl ? 'target="_blank" rel="noopener"' : '' %>>
                <% if (playlist.artworkUrl) { %><img class="music-art" src="<%= playlist.artworkUrl %>" alt=""/><% } else { %><div class="music-art" style="display:flex;align-items:center;justify-content:center;">♫</div><% } %>
                <div class="playlist-copy">
                    <div class="playlist-name"><%= playlist.name %></div>
                    <div class="playlist-meta"><%= playlist.provider === 'SPOTIFY' ? 'Spotify' : 'Apple Music' %> · Published playlist</div>
                </div>
                <span style="color:#555;">↗</span>
            </a>
        <% }) %>
    <% } %>

    <% if (!hideWeight && currentWeight) { %>
        <div class="section-heading">Body weight</div>
        <div class="card" style="display:flex;align-items:baseline;gap:0.4rem;">
            <span style="font-size:1.75rem;font-weight:800;letter-spacing:-1px;"><%= currentWeight %></span>
            <span style="font-size:0.85rem;color:#555;">lbs</span>
        </div>
    <% } %>

    <div class="section-heading">Lifts</div>

    <% if (liftsWithConfig.length === 0) { %>
        <div style="color:#555;font-size:0.9rem;padding:0.5rem 0;">No lifts configured yet.</div>
    <% } %>

    <% liftsWithConfig.forEach(w => { %>
        <div class="lift-row">
            <div class="lift-name"><%= w.name %></div>
            <div class="lift-meta">
                <% if (w.trainingMax) { %><div><%= w.trainingMax %> lbs TM</div><% } %>
                <% if (w.currentWeek) { %><div>Week <%= w.currentWeek %></div><% } %>
                <% if (!w.trainingMax) { %><div style="color:#444;">Not configured</div><% } %>
            </div>
        </div>
    <% }) %>

</body>
</html>
